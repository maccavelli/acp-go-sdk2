A union without a discriminator decodes an object into the variant whose
required keys it carries, before any trial decode, and an array into the
variant whose items carry theirs; an array whose items are not objects falls to
the trial decode (0012-MADR-schema-fidelity-framework.md). Found by the
mutation run of 0011-PLAN-engine-tests.md, step 9. The meta declares
$/cancel_request and the schema its smallest definition, which the runtime
needs.

-- meta.json --
{"version": 1, "agentMethods": {}, "clientMethods": {}, "protocolMethods": {"cancel_request": "$/cancel_request"}}
-- schema.json --
{"$defs": {
  "Note": {"type": "object", "properties": {"note": {"type": "string"}}},
  "Keyed": {"type": "object", "properties": {"k": {"type": "string"}}, "required": ["k"]},
  "Pick": {"anyOf": [{"title": "Loose", "$ref": "#/$defs/Note"}, {"title": "Keyed", "$ref": "#/$defs/Keyed"}]},
  "Batch": {"anyOf": [{"title": "Loose", "type": "array", "items": {"$ref": "#/$defs/Note"}}, {"title": "Keyed", "type": "array", "items": {"$ref": "#/$defs/Keyed"}}]},
  "Mixed": {"anyOf": [{"title": "Objects", "type": "array", "items": {"$ref": "#/$defs/Keyed"}}, {"title": "Words", "type": "array", "items": {"type": "string"}}]},
  "CancelRequestNotification": {"type": "object", "x-side": "protocol", "x-method": "$/cancel_request"}
}}
-- want.api --
