-- behaviour_test.go --
package acp

import (
	"encoding/json"
	"testing"
)

// The variant whose required keys the object carries takes it, though an
// earlier variant without required keys would decode it too.
func TestObjectByRequiredKeys(t *testing.T) {
	var p Pick
	if err := json.Unmarshal([]byte(`{"k":"v"}`), &p); err != nil || p.Keyed == nil || p.Loose != nil {
		t.Errorf(`{"k":"v"} decoded as %+v, %v; want Keyed`, p, err)
	}
	if err := json.Unmarshal([]byte(`{"note":"n"}`), &p); err != nil || p.Loose == nil {
		t.Errorf(`{"note":"n"} decoded as %+v, %v; want Loose`, p, err)
	}
}

// The array variant whose items carry their required keys takes the array.
func TestArrayByItemKeys(t *testing.T) {
	var b Batch
	if err := json.Unmarshal([]byte(`[{"k":"v"}]`), &b); err != nil || b.Keyed == nil || b.Loose != nil {
		t.Errorf(`[{"k":"v"}] decoded as %+v, %v; want Keyed`, b, err)
	}
}

// Items that are not objects match no variant by keys; the trial decode takes
// the array of strings.
func TestArrayOfNonObjects(t *testing.T) {
	var m Mixed
	if err := json.Unmarshal([]byte(`["a","b"]`), &m); err != nil || m.Words == nil || len(*m.Words) != 2 {
		t.Errorf(`["a","b"] decoded as %+v, %v; want Words`, m, err)
	}
	if err := json.Unmarshal([]byte(`[{"k":"v"}]`), &m); err != nil || m.Objects == nil {
		t.Errorf(`[{"k":"v"}] decoded as %+v, %v; want Objects`, m, err)
	}
}
