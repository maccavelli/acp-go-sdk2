-- behaviour_test.go --
package acp_test

import (
	"encoding/json"
	"testing"

	acp "enginetest/accept-unstable-variant-decode"
	"enginetest/accept-unstable-variant-decode/unstable"
)

// acp's Pick keeps a variant it does not declare in Unknown; package
// unstable's DecodePickN decodes it, and refuses a payload of another
// variant.
func TestDecodeNewVariant(t *testing.T) {
	var p acp.Pick
	if err := json.Unmarshal([]byte(`{"kind":"n","text":"hi"}`), &p); err != nil {
		t.Fatal(err)
	}
	if p.Unknown == nil {
		t.Fatalf("acp's Pick did not keep the variant it does not declare: %+v", p)
	}
	n, err := unstable.DecodePickN(p.Unknown)
	if err != nil || n.Text != "hi" {
		t.Fatalf("DecodePickN: %+v, %v", n, err)
	}
	if _, err := unstable.DecodePickN(json.RawMessage(`{"kind":"a"}`)); err == nil {
		t.Error("DecodePickN decoded a payload of the a variant")
	}
}
