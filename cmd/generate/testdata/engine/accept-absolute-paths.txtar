-- behaviour_test.go --
package acp

import (
	"errors"
	"testing"
)

// pathError requires err to be a *ValidationError for an absolute path on
// type typ and field field.
func pathError(t *testing.T, what string, err error, typ, field string) {
	t.Helper()
	var ve *ValidationError
	if !errors.As(err, &ve) || ve.Rule != RuleAbsolutePath || ve.Type != typ || ve.Field != field {
		t.Errorf("%s: Validate() = %v, want an absolute-path error on %s %s", what, err, typ, field)
	}
}

// Each shape refuses "" and a relative path, and accepts an absolute one.
func TestAbsolutePaths(t *testing.T) {
	abs := t.TempDir()
	if err := (&NewSessionRequest{Cwd: abs, AdditionalDirectories: []string{abs}}).Validate(); err != nil {
		t.Errorf("absolute paths: %v", err)
	}
	pathError(t, "empty cwd", (&NewSessionRequest{}).Validate(), "NewSessionRequest", "cwd")
	pathError(t, "relative cwd", (&NewSessionRequest{Cwd: "rel"}).Validate(), "NewSessionRequest", "cwd")
	pathError(t, "relative directory", (&NewSessionRequest{Cwd: abs, AdditionalDirectories: []string{abs, "rel"}}).Validate(),
		"NewSessionRequest", "additionalDirectories[1]")

	if err := (&CreateTerminalRequest{Command: "c"}).Validate(); err != nil {
		t.Errorf("unset optional cwd: %v", err)
	}
	rel := "rel"
	pathError(t, "relative optional cwd", (&CreateTerminalRequest{Command: "c", Cwd: &rel}).Validate(), "CreateTerminalRequest", "cwd")

	pathError(t, "relative diff path", (&Diff{Path: "rel"}).Validate(), "Diff", "path")
	u := ToolCallContent{Diff: &ToolCallContentDiff{Type: "diff", Path: "rel"}}
	pathError(t, "relative path in the diff variant", u.Validate(), "ToolCallContentDiff", "path")
	u.Diff.Path = abs
	if err := u.Validate(); err != nil {
		t.Errorf("absolute path in the diff variant: %v", err)
	}
}
