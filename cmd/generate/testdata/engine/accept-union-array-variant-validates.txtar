-- behaviour_test.go --
package acp

import (
	"strings"
	"testing"
)

// The same short name fails Validate in a field of the array and in each
// array variant, and a good one passes.
func TestUnionArrayVariantValidates(t *testing.T) {
	bad, good := Option{Name: ""}, Option{Name: "n"}
	for name, r := range map[string]Root{
		"a direct field":      {Direct: []Option{good, bad}},
		"the Ungrouped variant": {Opts: Options{Ungrouped: &OptionsUngrouped{good, bad}}},
		"the Grouped variant":   {Opts: Options{Grouped: &OptionsGrouped{{Group: "g", Options: []Option{bad}}}}},
	} {
		err := r.Validate()
		if err == nil || !strings.Contains(err.Error(), "Option: name: shorter than minLength 1") {
			t.Errorf("%s: Validate = %v, want the short name refused", name, err)
		}
	}
	if err := (&Root{Opts: Options{Ungrouped: &OptionsUngrouped{good}}}).Validate(); err != nil {
		t.Errorf("a good option: %v", err)
	}
}
