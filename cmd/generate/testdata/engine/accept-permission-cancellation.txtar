{"$defs": {
  "PromptRequest": {"type": "object", "properties": {"sessionId": {"type": "string"}}, "required": ["sessionId"], "x-side": "agent", "x-method": "session/prompt"},
  "StopReason": {"type": "string", "enum": ["end_turn", "cancelled"]},
  "PromptResponse": {"type": "object", "properties": {"stopReason": {"$ref": "#/$defs/StopReason"}}, "required": ["stopReason"], "x-side": "agent", "x-method": "session/prompt"},
  "CancelNotification": {"type": "object", "properties": {"sessionId": {"type": "string"}}, "required": ["sessionId"], "x-side": "agent", "x-method": "session/cancel"},
  "RequestPermissionRequest": {"type": "object", "properties": {"sessionId": {"type": "string"}}, "required": ["sessionId"], "x-side": "client", "x-method": "session/request_permission"},
  "RequestPermissionResponse": {"type": "object", "properties": {"outcome": {"$ref": "#/$defs/RequestPermissionOutcome"}}, "required": ["outcome"], "x-side": "client", "x-method": "session/request_permission"},
  "RequestPermissionOutcome": {"oneOf": [
    {"type": "object", "properties": {"outcome": {"type": "string", "const": "cancelled"}}, "required": ["outcome"]},
    {"type": "object", "properties": {"outcome": {"type": "string", "const": "selected"}, "optionId": {"type": "string"}}, "required": ["outcome", "optionId"]}
  ], "discriminator": {"propertyName": "outcome"}},
  "CancelRequestNotification": {"type": "object", "x-side": "protocol", "x-method": "$/cancel_request"}
}}
