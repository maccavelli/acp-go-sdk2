-- behaviour_test.go --
package acp

import (
	"context"
	"io"
	"testing"
	"time"
)

type idleAgent struct{}

func (idleAgent) Prompt(ctx context.Context, _ PromptRequest) (PromptResponse, error) {
	<-ctx.Done()
	return PromptResponse{}, ctx.Err()
}

func (idleAgent) Cancel(context.Context, CancelNotification) error { return nil }

// stuckClient's handler ignores its context and waits until the test ends.
type stuckClient struct{ asked, end chan struct{} }

func (c stuckClient) RequestPermission(context.Context, RequestPermissionRequest) (RequestPermissionResponse, error) {
	c.asked <- struct{}{}
	<-c.end
	return RequestPermissionResponse{Outcome: NewRequestPermissionOutcomeSelected("allow")}, nil
}

// The client's Cancel answers its session's pending permission request with
// the cancelled outcome, though the handler has not returned.
func TestPermissionCancelled(t *testing.T) {
	ar, cw := io.Pipe()
	cr, aw := io.Pipe()
	end := make(chan struct{})
	t.Cleanup(func() { close(end); _ = cw.Close(); _ = aw.Close() })
	asc := NewAgentSideConnection(idleAgent{}, aw, ar)
	client := stuckClient{asked: make(chan struct{}, 1), end: end}
	c := NewClientSideConnection(client, cw, cr)
	answer := make(chan RequestPermissionResponse, 1)
	go func() {
		resp, err := asc.RequestPermission(context.Background(), RequestPermissionRequest{SessionId: "s"})
		if err != nil {
			t.Errorf("RequestPermission: %v", err)
		}
		answer <- resp
	}()
	select {
	case <-client.asked:
	case <-time.After(10 * time.Second):
		t.Fatal("the request did not arrive")
	}
	if err := c.Cancel(t.Context(), CancelNotification{SessionId: "s"}); err != nil {
		t.Fatal(err)
	}
	select {
	case resp := <-answer:
		if resp.Outcome.Cancelled == nil {
			t.Errorf("answered %+v, want the cancelled outcome", resp.Outcome)
		}
	case <-time.After(10 * time.Second):
		t.Fatal("the request was not answered")
	}
}
