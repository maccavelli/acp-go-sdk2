-- behaviour_test.go --
package acp

import (
	"encoding/json"
	"testing"
)

// null and [] each re-encode as they came.
func TestRequiredNullableCollection(t *testing.T) {
	for _, in := range []string{`{"xs":null}`, `{"xs":[]}`, `{"xs":["a"]}`} {
		var v T
		if err := json.Unmarshal([]byte(in), &v); err != nil {
			t.Fatalf("%s: %v", in, err)
		}
		b, err := json.Marshal(v)
		if err != nil || string(b) != in {
			t.Errorf("%s re-encoded as %s, %v", in, b, err)
		}
	}
}
