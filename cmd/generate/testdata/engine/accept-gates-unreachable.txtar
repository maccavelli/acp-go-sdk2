-- behaviour_test.go --
package acp

import "testing"

// TestGatesOnlyWhereTheDispatchReaches requires gates on the notification's
// params, on the union it holds and on the variant an allOf was flattened
// into, and none on a type no method reaches, by a property or by allOf.
func TestGatesOnlyWhereTheDispatchReaches(t *testing.T) {
	if _, ok := any(&SessionNotification{}).(gater); !ok {
		t.Error("SessionNotification, which a method carries, has no gates")
	}
	if _, ok := any(&SessionUpdate{}).(gater); !ok {
		t.Error("SessionUpdate, which SessionNotification holds, has no gates")
	}
	if _, ok := any(&Archive{}).(gater); ok {
		t.Error("Archive, which no method reaches, has gates")
	}
	if _, ok := any(&SessionBatchUpdate{}).(gater); !ok {
		t.Error("SessionBatchUpdate, which SessionUpdate holds, has no gates")
	}
	if _, ok := any(&Batch{}).(gater); ok {
		t.Error("Batch, reached only by allOf, has gates")
	}
}
