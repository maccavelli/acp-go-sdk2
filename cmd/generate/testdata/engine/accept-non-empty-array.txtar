-- behaviour_test.go --
package acp

import (
	"context"
	"encoding/json"
	"errors"
	"io"
	"testing"
	"time"
)

// startAgent advertises caps and reports each start it handles on got.
type startAgent struct {
	caps AgentCapabilities
	got  chan StartRequest
}

func (a startAgent) Initialize(context.Context, InitializeRequest) (InitializeResponse, error) {
	return InitializeResponse{AgentCapabilities: a.caps}, nil
}

func (a startAgent) Start(_ context.Context, p StartRequest) (StartResponse, error) {
	a.got <- p
	return StartResponse{}, nil
}

type noClient struct{}

// pair connects a client to an agent that advertises caps, and initializes.
func pair(t *testing.T, caps AgentCapabilities) (*ClientSideConnection, chan StartRequest) {
	t.Helper()
	ar, cw := io.Pipe()
	cr, aw := io.Pipe()
	t.Cleanup(func() { _ = cw.Close(); _ = aw.Close() })
	got := make(chan StartRequest, 8)
	NewAgentSideConnection(startAgent{caps, got}, aw, ar)
	csc := NewClientSideConnection(noClient{}, cw, cr)
	if _, err := csc.Initialize(t.Context(), InitializeRequest{}); err != nil {
		t.Fatal(err)
	}
	return csc, got
}

// rawRefused requires the JSON raw, sent as x/start's params past the typed
// gate, to be answered -32602, the agent's Start not called.
func rawRefused(t *testing.T, csc *ClientSideConnection, got chan StartRequest, raw string) {
	t.Helper()
	var re *RequestError
	if _, err := SendRequest[StartResponse](csc.Connection(), t.Context(), AgentMethodStart, json.RawMessage(raw)); !errors.As(err, &re) || re.Code != -32602 {
		t.Errorf("raw %s = %v, want -32602", raw, err)
	}
	select {
	case p := <-got:
		t.Errorf("Start handled %+v", p)
	default:
	}
}

// refused requires the typed send of p to return a *CapabilityError naming
// capability, field and variant, and p sent raw to be answered -32602.
func refused(t *testing.T, csc *ClientSideConnection, got chan StartRequest, p StartRequest, capability, field, variant string) {
	t.Helper()
	var ce *CapabilityError
	if _, err := csc.Start(t.Context(), p); !errors.As(err, &ce) || ce.Method != AgentMethodStart || ce.Capability != capability ||
		ce.Field != field || ce.Variant != variant {
		t.Errorf("Start = %v; want a *CapabilityError naming %s, field %q, variant %q", err, capability, field, variant)
	}
	raw, err := json.Marshal(p)
	if err != nil {
		t.Fatal(err)
	}
	rawRefused(t, csc, got, string(raw))
}

// passes requires p to be sent and handled.
func passes(t *testing.T, csc *ClientSideConnection, got chan StartRequest, p StartRequest) StartRequest {
	t.Helper()
	if _, err := csc.Start(t.Context(), p); err != nil {
		t.Fatalf("Start = %v", err)
	}
	select {
	case h := <-got:
		return h
	case <-time.After(5 * time.Second):
		t.Fatal("Start was not handled")
	}
	return StartRequest{}
}

func text(mode Mode, blocks ...Block) StartRequest {
	if blocks == nil {
		blocks = []Block{NewBlockText("x")}
	}
	return StartRequest{Instructions: &Instructions{Mode: mode, Content: blocks}}
}

var everything = AgentCapabilities{Prompt: &PromptCaps{Mode: &ModeCaps{Replace: &Flag{}}}}

// Empty or nil content is refused both ways.
func TestNonEmptyArray(t *testing.T) {
	csc, got := pair(t, everything)
	for _, blocks := range [][]Block{{}, nil} {
		in := Instructions{Mode: ModeAdd, Content: blocks}
		var ve *ValidationError
		if err := in.Validate(); !errors.As(err, &ve) || ve.Rule != RuleMinItems || ve.Field != "content" {
			t.Errorf("Validate(%#v) = %v, want RuleMinItems on content", blocks, err)
		}
		if _, err := csc.Start(t.Context(), StartRequest{Instructions: &in}); !errors.As(err, &ve) || ve.Rule != RuleMinItems {
			t.Errorf("Start(%#v) = %v, want a *ValidationError with RuleMinItems", blocks, err)
		}
	}
	rawRefused(t, csc, got, `{"instructions":{"mode":"add","content":[]}}`)
	passes(t, csc, got, text(ModeAdd))
}
