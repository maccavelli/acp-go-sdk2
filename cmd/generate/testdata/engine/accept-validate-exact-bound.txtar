-- behaviour_test.go --
package acp

import "testing"

// The schema's largest value passes, and the one after it does not.
func TestExactBound(t *testing.T) {
	if err := (&T{X: 9007199254740993}).Validate(); err != nil {
		t.Errorf("2^53+1: %v, want nil", err)
	}
	if err := (&T{X: 9007199254740994}).Validate(); err == nil {
		t.Error("2^53+2: nil, want an error")
	}
}
