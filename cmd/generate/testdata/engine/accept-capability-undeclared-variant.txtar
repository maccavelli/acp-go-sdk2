-- behaviour_test.go --
package acp

import (
	"context"
	"errors"
	"io"
	"testing"
	"time"
)

type elicitAgent struct{}

func (elicitAgent) Initialize(context.Context, InitializeRequest) (InitializeResponse, error) {
	return InitializeResponse{}, nil
}

// elicitClient reports the mode of each elicitation it handles on modes.
type elicitClient struct{ modes chan string }

func (c elicitClient) CreateElicitation(_ context.Context, p CreateElicitationRequest) (CreateElicitationResponse, error) {
	switch {
	case p.Form != nil:
		c.modes <- p.Form.Mode
	case p.Url != nil:
		c.modes <- p.Url.Mode
	case p.Other != nil:
		c.modes <- p.Other.Mode
	}
	return CreateElicitationResponse{}, nil
}

// An elicitation in a mode the schema does not list is refused when sent,
// naming the mode, and answered -32602 when received, though the client
// advertises every mode the schema lists; a listed mode goes through.
func TestUndeclaredModeRefused(t *testing.T) {
	ar, cw := io.Pipe()
	cr, aw := io.Pipe()
	t.Cleanup(func() { _ = cw.Close(); _ = aw.Close() })
	modes := make(chan string, 4)
	asc := NewAgentSideConnection(elicitAgent{}, aw, ar)
	csc := NewClientSideConnection(elicitClient{modes}, cw, cr)
	all := ClientCapabilities{Elicitation: &ElicitationCapabilities{Form: &Flag{}, Url: &Flag{}}}
	if _, err := csc.Initialize(t.Context(), InitializeRequest{ClientCapabilities: all}); err != nil {
		t.Fatal(err)
	}

	telepathy := NewCreateElicitationRequestOther("telepathy")
	var ce *CapabilityError
	if _, err := asc.CreateElicitation(t.Context(), telepathy); !errors.As(err, &ce) || ce.Method != ClientMethodElicit ||
		ce.Capability != "elicitation.telepathy" || ce.Variant != "telepathy" {
		t.Errorf("CreateElicitation(telepathy) = %v", err)
	}
	var re *RequestError
	if _, err := SendRequest[CreateElicitationResponse](asc.Connection(), t.Context(), ClientMethodElicit, telepathy); !errors.As(err, &re) || re.Code != -32602 {
		t.Errorf("a raw telepathy elicitation = %v, want -32602", err)
	}
	if _, err := asc.CreateElicitation(t.Context(), NewCreateElicitationRequestForm("m")); err != nil {
		t.Fatalf("CreateElicitation(form) = %v", err)
	}
	select {
	case m := <-modes:
		if m != "form" {
			t.Errorf("the client handled %q first, want form", m)
		}
	case <-time.After(5 * time.Second):
		t.Fatal("the form elicitation was not handled")
	}
	if len(modes) != 0 {
		t.Errorf("the client also handled %q", <-modes)
	}
}
