The protocol table's undeclared-variant rule: an elicitation request whose
mode the schema does not list, held by its union's catch-all, is one no
capability advertises, so it is refused when sent and answered -32602 when
received, with every elicitation capability advertised
(0019-PLAN-api-decisions.md, B20).

-- meta.json --
{"version": 1, "agentMethods": {"initialize": "initialize"}, "clientMethods": {"elicit": "x/elicit"}, "protocolMethods": {"cancel_request": "$/cancel_request"}}
-- schema.json --
{"$defs": {
  "ProtocolVersion": {"type": "integer", "format": "uint16"},
  "Flag": {"type": "object"},
  "ElicitationCapabilities": {"type": "object", "properties": {"form": {"anyOf": [{"$ref": "#/$defs/Flag"}, {"type": "null"}]}, "url": {"anyOf": [{"$ref": "#/$defs/Flag"}, {"type": "null"}]}}},
  "ClientCapabilities": {"type": "object", "properties": {"elicitation": {"anyOf": [{"$ref": "#/$defs/ElicitationCapabilities"}, {"type": "null"}]}}},
  "AgentCapabilities": {"type": "object", "properties": {"loadSession": {"type": "boolean"}}},
  "InitializeRequest": {"type": "object", "properties": {"protocolVersion": {"$ref": "#/$defs/ProtocolVersion"}, "clientCapabilities": {"$ref": "#/$defs/ClientCapabilities"}}, "required": ["protocolVersion"], "x-side": "agent", "x-method": "initialize"},
  "InitializeResponse": {"type": "object", "properties": {"protocolVersion": {"$ref": "#/$defs/ProtocolVersion"}, "agentCapabilities": {"$ref": "#/$defs/AgentCapabilities"}}, "required": ["protocolVersion"], "x-side": "agent", "x-method": "initialize"},
  "CreateElicitationRequest": {"anyOf": [
    {"title": "form", "type": "object", "required": ["mode", "message"], "properties": {"mode": {"const": "form", "type": "string"}, "message": {"type": "string"}}},
    {"title": "url", "type": "object", "required": ["mode", "url"], "properties": {"mode": {"const": "url", "type": "string"}, "url": {"type": "string"}}},
    {"title": "other", "type": "object", "required": ["mode"], "properties": {"mode": {"type": "string"}}, "not": {"anyOf": [
      {"type": "object", "required": ["mode"], "properties": {"mode": {"const": "form", "type": "string"}}},
      {"type": "object", "required": ["mode"], "properties": {"mode": {"const": "url", "type": "string"}}}]}}
  ], "x-side": "client", "x-method": "x/elicit"},
  "CreateElicitationResponse": {"type": "object", "x-side": "client", "x-method": "x/elicit"},
  "CancelRequestNotification": {"type": "object", "x-side": "protocol", "x-method": "$/cancel_request"}
}}
