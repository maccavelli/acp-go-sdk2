  "$defs": {
    "Shared": {
      "type": "object",
      "properties": {
        "a": {
          "type": "string"
        },
        "b": {
          "type": "integer"
        }
      }
    },
    "OldRequest": {
      "type": "object",
      "properties": {
        "s": {
          "$ref": "#/$defs/Shared"
        }
      },
      "required": [
        "s"
      ],
      "x-side": "agent",
      "x-method": "x/old"
    },
    "OldResponse": {
      "type": "object",
      "x-side": "agent",
      "x-method": "x/old"
    },
    "CancelRequestNotification": {
      "type": "object",
      "x-side": "protocol",
      "x-method": "$/cancel_request"
    }
  }
}
