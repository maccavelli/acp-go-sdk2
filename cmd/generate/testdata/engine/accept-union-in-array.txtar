Unions held in an array, a nullable property, and a map.
The meta declares $/cancel_request and the schema its smallest definition, which
the runtime needs.

-- meta.json --
{"version": 1, "agentMethods": {}, "clientMethods": {}, "protocolMethods": {"cancel_request": "$/cancel_request"}}
-- schema.json --
{"$defs": {
  "U": {"oneOf": [{"type": "object", "properties": {"type": {"type": "string", "const": "a"}}, "required": ["type"]}, {"type": "object", "properties": {"type": {"type": "string", "const": "b"}}, "required": ["type"]}]},
  "Holder": {"type": "object", "properties": {"all": {"type": "array", "items": {"$ref": "#/$defs/U"}}, "maybe": {"anyOf": [{"$ref": "#/$defs/U"}, {"type": "null"}]}, "byName": {"type": "object", "additionalProperties": {"$ref": "#/$defs/U"}}}, "required": ["all"]},
  "CancelRequestNotification": {"type": "object", "x-side": "protocol", "x-method": "$/cancel_request"}
}}
