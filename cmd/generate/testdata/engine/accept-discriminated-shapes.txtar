-- behaviour_test.go --
package acp

import (
	"encoding/json"
	"testing"
)

// Each variant decodes by its discriminator; a value no variant names goes to
// the catch-all, and a payload without one to the variant without a value.
func TestEventVariants(t *testing.T) {
	for in, want := range map[string]string{
		`{"kind":"start","at":9007199254740993}`: "start",
		`{"kind":"stop"}`:                        "stop",
		`{"kind":"pause"}`:                       "other",
		`{}`:                                     "none",
	} {
		var e Event
		if err := json.Unmarshal([]byte(in), &e); err != nil {
			t.Errorf("%s: %v", in, err)
			continue
		}
		got := map[bool]string{e.Start != nil: "start", e.Stop != nil: "stop", e.Other != nil: "other", e.None != nil: "none"}[true]
		if got != want {
			t.Errorf("%s decoded as %+v, want %s", in, e, want)
		}
	}
	var e Event
	if err := json.Unmarshal([]byte(`{"kind":"start","at":9007199254740993}`), &e); err != nil || e.Start == nil || e.Start.At != 9007199254740993 {
		t.Errorf("start decoded as %+v, %v", e, err)
	}
}

// A catch-all listed first still takes only the values no other variant names.
func TestMarkCatchAllFirst(t *testing.T) {
	var m Mark
	if err := json.Unmarshal([]byte(`{"kind":"a"}`), &m); err != nil || m.Other != nil {
		t.Errorf(`{"kind":"a"} decoded as %+v, %v; want the const variant`, m, err)
	}
	if err := json.Unmarshal([]byte(`{"kind":"b","x":1}`), &m); err != nil || m.Other == nil || m.Other.Kind != "b" || string(m.Other.Extra["x"]) != "1" {
		t.Errorf(`{"kind":"b","x":1} decoded as %+v, %v; want Other`, m, err)
	}
}
