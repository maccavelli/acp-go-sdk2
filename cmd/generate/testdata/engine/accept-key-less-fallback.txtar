-- behaviour_test.go --
package acp

import (
	"bytes"
	"encoding/json"
	"reflect"
	"strings"
	"testing"
)

func which(u SetSessionConfigOptionRequest) string {
	switch {
	case u.Boolean != nil:
		return "Boolean"
	case u.ValueId != nil:
		return "ValueId " + u.ValueId.Value
	case u.Unknown != nil:
		return "Unknown"
	}
	return "none"
}

func sameJSON(t *testing.T, got []byte, want string) {
	t.Helper()
	decode := func(b []byte) any {
		d := json.NewDecoder(bytes.NewReader(b))
		d.UseNumber()
		var v any
		if err := d.Decode(&v); err != nil {
			t.Fatalf("%s: %v", b, err)
		}
		return v
	}
	if !reflect.DeepEqual(decode(got), decode([]byte(want))) {
		t.Errorf("got %s, want %s", got, want)
	}
}

// An unknown type with a string value is the value-id variant; with a value
// that is not a string it is kept, and sent back unchanged.
func TestFallback(t *testing.T) {
	for in, want := range map[string]string{
		`{"type":"future","value":"x"}`:   "ValueId x",
		`{"value":"x"}`:                   "ValueId x",
		`{"type":"value_id","value":"x"}`: "ValueId x",
		`{"type":"boolean","value":true}`: "Boolean",
		`{"type":"future","value":true}`:  "Unknown",
	} {
		var u SetSessionConfigOptionRequest
		if err := json.Unmarshal([]byte(in), &u); err != nil {
			t.Fatalf("%s: %v", in, err)
		}
		if got := which(u); got != want {
			t.Errorf("%s decoded as %s, want %s", in, got, want)
		}
	}
	var u SetSessionConfigOptionRequest
	in := `{"type":"future","value":true}`
	if err := json.Unmarshal([]byte(in), &u); err != nil {
		t.Fatal(err)
	}
	b, err := json.Marshal(u)
	if err != nil {
		t.Fatal(err)
	}
	sameJSON(t, b, in)
}

// The own name is strict.
func TestFallbackOwnNameStrict(t *testing.T) {
	var u SetSessionConfigOptionRequest
	err := json.Unmarshal([]byte(`{"type":"value_id","value":true}`), &u)
	if err == nil || !strings.Contains(err.Error(), `SetSessionConfigOptionRequest: type "value_id"`) {
		t.Errorf("= %v, decoded as %s; want an error naming the value", err, which(u))
	}
}

// A union no rule names keeps an unknown type in Unknown, whatever its value.
func TestNoRuleNoFallback(t *testing.T) {
	var v V
	if err := json.Unmarshal([]byte(`{"type":"future","value":"x"}`), &v); err != nil {
		t.Fatal(err)
	}
	if v.Unknown == nil || v.ValueId != nil {
		t.Errorf("V decoded as %+v, want Unknown", v)
	}
}
