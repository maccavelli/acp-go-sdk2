The generated decoders read a key as encoding/json reads a struct field's name:
under Unicode case folding, the last matching key winning, for required keys,
defaults, members, discriminators, a catch-all's extra keys, and array items
(0011-MADR-harden-code-generator-engine.md, "Found in step 8 and decided").
The meta declares $/cancel_request and the schema its smallest definition, which
the runtime needs.

-- meta.json --
{"version": 1, "agentMethods": {}, "clientMethods": {}, "protocolMethods": {"cancel_request": "$/cancel_request"}}
-- schema.json --
{"$defs": {
  "Item": {"type": "object", "properties": {"id": {"type": "string"}, "count": {"type": "integer", "format": "int64", "default": 3}}, "required": ["id"]},
  "State": {"type": "object", "properties": {"stopReason": {"type": ["string", "null"]}}, "anyOf": [{"title": "end", "type": "object", "properties": {"stopReason": {"type": "string", "const": "end_turn"}}, "required": ["stopReason"]}, {"title": "other", "type": "object", "properties": {"stopReason": {"type": "string"}}, "required": ["stopReason"], "not": {"anyOf": [{"type": "object", "properties": {"stopReason": {"type": "string", "const": "end_turn"}}, "required": ["stopReason"]}]}}, {"title": "none", "type": "object", "properties": {"stopReason": {"type": "null"}}}]},
  "SessionScope": {"type": "object", "properties": {"sessionId": {"type": "string"}}, "required": ["sessionId"]},
  "RequestScope": {"type": "object", "properties": {"requestId": {"type": "integer", "format": "int64"}}, "required": ["requestId"]},
  "Mode": {"type": "object", "properties": {"message": {"type": "string"}}, "required": ["message"], "anyOf": [{"title": "Session", "allOf": [{"$ref": "#/$defs/SessionScope"}]}, {"title": "Request", "allOf": [{"$ref": "#/$defs/RequestScope"}]}]},
  "Option": {"type": "object", "properties": {"value": {"type": "string"}, "name": {"type": "string"}}, "required": ["value", "name"]},
  "Group": {"type": "object", "properties": {"group": {"type": "string"}, "options": {"type": "array", "items": {"$ref": "#/$defs/Option"}}}, "required": ["group", "options"]},
  "Options": {"anyOf": [{"title": "Ungrouped", "type": "array", "items": {"$ref": "#/$defs/Option"}}, {"title": "Grouped", "type": "array", "items": {"$ref": "#/$defs/Group"}}]},
  "CancelRequestNotification": {"type": "object", "x-side": "protocol", "x-method": "$/cancel_request"}
}}
-- want.api --
