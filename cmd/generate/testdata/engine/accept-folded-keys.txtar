type AgentExperimental interface{}
type CancelRequestNotification struct{}
type Client interface{}
type ClientExperimental interface{}
type Group struct{Group string "json:\"group\""; Options []Option "json:\"options\""}
type Item struct{Count int64 "json:\"count,omitempty\""; Id string "json:\"id\""}
type Mode struct{Message string "json:\"message\""; Session *SessionScope "json:\"-\""; Request *RequestScope "json:\"-\""}
type Option struct{Name string "json:\"name\""; Value string "json:\"value\""}
type Options struct{Ungrouped *OptionsUngrouped "json:\"-\""; Grouped *OptionsGrouped "json:\"-\""}
type OptionsGrouped []Group
type OptionsUngrouped []Option
const ProtocolMethodCancelRequest untyped string = "$/cancel_request"
const ProtocolVersionNumber untyped int = 1
type RequestScope struct{RequestId int64 "json:\"requestId\""}
type SessionScope struct{SessionId string "json:\"sessionId\""}
type State struct{EndTurn *StateEnd "json:\"-\""; Other *StateOther "json:\"-\""; None *StateNone "json:\"-\""}
type StateEnd struct{StopReason string "json:\"stopReason\""}
type StateNone struct{StopReason json.RawMessage "json:\"stopReason,omitempty\""}
type StateOther struct{StopReason string "json:\"stopReason\""; Extra map[string]json.RawMessage "json:\"-\""}
