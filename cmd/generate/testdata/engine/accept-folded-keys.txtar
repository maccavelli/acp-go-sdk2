-- behaviour_test.go --
package acp

import (
	"encoding/json"
	"testing"
)

// A required key or a key with a default, in another case, is read as
// encoding/json reads its field; of several matching keys, the last wins.
func TestFoldedObjectKeys(t *testing.T) {
	for in, want := range map[string]Item{
		`{"ID":"a"}`:                  {Id: "a", Count: 3},
		`{"id":"a","Count":5}`:        {Id: "a", Count: 5},
		`{"id":"a","ID":"b"}`:         {Id: "b", Count: 3},
		`{"ID":"b","id":"a"}`:         {Id: "a", Count: 3},
	} {
		var v Item
		if err := json.Unmarshal([]byte(in), &v); err != nil || v != want {
			t.Errorf("%s decoded as %+v, %v; want %+v", in, v, err, want)
		}
	}
	var v Item
	if err := json.Unmarshal([]byte(`{"i_d":"a"}`), &v); err == nil {
		t.Errorf(`{"i_d":"a"} decoded as %+v; a key is not matched with "_" removed`, v)
	}
}

// A discriminator in another case selects its variant, and the catch-all
// keeps only the keys no field takes.
func TestFoldedDiscriminator(t *testing.T) {
	var s State
	if err := json.Unmarshal([]byte(`{"StopReason":"end_turn"}`), &s); err != nil || s.EndTurn == nil {
		t.Errorf(`{"StopReason":"end_turn"} decoded as %+v, %v; want EndTurn`, s, err)
	}
	if err := json.Unmarshal([]byte(`{"STOPREASON":"custom","x":1}`), &s); err != nil || s.Other == nil {
		t.Fatalf(`{"STOPREASON":"custom","x":1} decoded as %+v, %v; want Other`, s, err)
	}
	if s.Other.StopReason != "custom" || len(s.Other.Extra) != 1 || string(s.Other.Extra["x"]) != "1" {
		t.Errorf("Other = %+v; want stopReason custom and the one extra key x", s.Other)
	}
	if b, err := json.Marshal(s); err != nil || string(b) != `{"stopReason":"custom","x":1}` {
		t.Errorf("Other sent as %s, %v", b, err)
	}
	if err := json.Unmarshal([]byte(`{"stopreason":null}`), &s); err != nil || s.None == nil {
		t.Errorf(`{"stopreason":null} decoded as %+v, %v; want None`, s, err)
	}
}

// A member's key in another case picks the member.
func TestFoldedMemberKeys(t *testing.T) {
	var m Mode
	if err := json.Unmarshal([]byte(`{"Message":"m","SessionId":"s"}`), &m); err != nil || m.Session == nil || m.Session.SessionId != "s" || m.Message != "m" {
		t.Errorf("Mode decoded as %+v, %v; want the Session member", m, err)
	}
}

// An array item's keys in another case pick the array variant.
func TestFoldedArrayItems(t *testing.T) {
	var o Options
	if err := json.Unmarshal([]byte(`[{"Group":"g","OPTIONS":[{"value":"v","Name":"n"}]}]`), &o); err != nil || o.Grouped == nil {
		t.Fatalf("Options decoded as %+v, %v; want Grouped", o, err)
	}
	if got := *o.Grouped; len(got) != 1 || got[0].Group != "g" || len(got[0].Options) != 1 || got[0].Options[0].Name != "n" {
		t.Errorf("Grouped = %+v", got)
	}
}
