-- behaviour_test.go --
package acp

import (
	"encoding/json"
	"testing"
)

// Each const member's payload decodes into its field, and an untyped string
// const is still a string.
func TestTypedConstMember(t *testing.T) {
	var v Thing
	if err := json.Unmarshal([]byte(`{"n":5,"f":true,"s":"x"}`), &v); err != nil {
		t.Fatal(err)
	}
	if v.N == nil || *v.N != 5 || v.F == nil || !*v.F || v.S == nil || *v.S != "x" {
		t.Errorf("decoded %+v, want n 5, f true and s x", v)
	}
}
