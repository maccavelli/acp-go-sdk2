A oneOf with discriminator.propertyName and $ref variants.
The meta declares $/cancel_request and the schema its smallest definition, which
the runtime needs.

-- meta.json --
{"version": 1, "agentMethods": {}, "clientMethods": {}, "protocolMethods": {"cancel_request": "$/cancel_request"}}
-- schema.json --
{"$defs": {
  "Circle": {"type": "object", "properties": {"kind": {"type": "string", "const": "circle"}, "r": {"type": "integer", "format": "int64"}}, "required": ["kind", "r"]},
  "Square": {"type": "object", "properties": {"kind": {"type": "string", "const": "square"}, "side": {"type": "string"}}, "required": ["kind", "side"]},
  "Shape": {"oneOf": [{"allOf": [{"$ref": "#/$defs/Circle"}], "properties": {"kind": {"type": "string", "const": "circle"}}, "required": ["kind"]}, {"allOf": [{"$ref": "#/$defs/Square"}], "properties": {"kind": {"type": "string", "const": "square"}}, "required": ["kind"]}], "discriminator": {"propertyName": "kind"}},
  "CancelRequestNotification": {"type": "object", "x-side": "protocol", "x-method": "$/cancel_request"}
}}
-- want.api --
type Agent interface{}
type AgentExperimental interface{}
type CancelRequestNotification struct{}
type Circle struct{Kind string "json:\"kind\""; R int64 "json:\"r\""}
type Client interface{}
type ClientExperimental interface{}
func NewShapeCircle(r int64) Shape
func NewShapeSquare(side string) Shape
const ProtocolMethodCancelRequest untyped string = "$/cancel_request"
const ProtocolVersionNumber untyped int = 1
type Shape struct{Circle *ShapeCircle "json:\"-\""; Square *ShapeSquare "json:\"-\""; Unknown json.RawMessage "json:\"-\""}
type ShapeCircle struct{Kind string "json:\"kind\""; R int64 "json:\"r\""}
type ShapeSquare struct{Kind string "json:\"kind\""; Side string "json:\"side\""}
type Square struct{Kind string "json:\"kind\""; Side string "json:\"side\""}
func (*CancelRequestNotification).Validate() error
func (*Circle).UnmarshalJSON(b []byte) error
func (Shape).MarshalJSON() ([]byte, error)
func (*Shape).UnmarshalJSON(b []byte) error
func (*Shape).Validate() error
func (*ShapeCircle).UnmarshalJSON(b []byte) error
func (*ShapeSquare).UnmarshalJSON(b []byte) error
func (*Square).UnmarshalJSON(b []byte) error
-- behaviour_test.go --
package acp

import (
	"bytes"
	"encoding/json"
	"reflect"
	"testing"
)

func jsonEqual(t *testing.T, got []byte, want string) {
	t.Helper()
	decode := func(b []byte) any {
		d := json.NewDecoder(bytes.NewReader(b))
		d.UseNumber()
		var v any
		if err := d.Decode(&v); err != nil {
			t.Fatalf("%s: %v", b, err)
		}
		return v
	}
	if !reflect.DeepEqual(decode(got), decode([]byte(want))) {
		t.Errorf("got %s, want %s", got, want)
	}
}

// Each variant, and an unknown kind, round-trips; integers keep every digit at
// both ends of int64.
func TestShapeRoundTrip(t *testing.T) {
	for _, in := range []string{
		`{"kind":"circle","r":9223372036854775807}`,
		`{"kind":"circle","r":-9223372036854775808}`,
		`{"kind":"circle","r":9007199254740993}`,
		`{"kind":"square","side":"s"}`,
		`{"kind":"hexagon","n":6,"deep":{"a":[1,2]}}`,
	} {
		var s Shape
		if err := json.Unmarshal([]byte(in), &s); err != nil {
			t.Fatalf("%s: %v", in, err)
		}
		b, err := json.Marshal(s)
		if err != nil {
			t.Fatalf("%s: %v", in, err)
		}
		jsonEqual(t, b, in)
	}
}

func TestShapeVariants(t *testing.T) {
	var s Shape
	if err := json.Unmarshal([]byte(`{"kind":"circle","r":9007199254740993}`), &s); err != nil {
		t.Fatal(err)
	}
	if s.Circle == nil || s.Circle.R != 9007199254740993 || s.Square != nil || s.Unknown != nil {
		t.Errorf("circle decoded as %+v", s)
	}
	if err := json.Unmarshal([]byte(`{"kind":"hexagon"}`), &s); err != nil {
		t.Fatal(err)
	}
	if s.Circle != nil || s.Square != nil || string(s.Unknown) != `{"kind":"hexagon"}` {
		t.Errorf("unknown kind decoded as %+v", s)
	}
}

// Without its discriminator, a payload decodes as the one variant whose
// required keys it carries, else it is kept in Unknown
// (0011-PLAN-wire-fixes.md; TestAbsentDiscriminator at the root).
func TestShapeAbsentDiscriminator(t *testing.T) {
	var s Shape
	if err := json.Unmarshal([]byte(`{"side":"s"}`), &s); err != nil {
		t.Fatal(err)
	}
	if s.Square == nil || s.Square.Side != "s" {
		t.Errorf(`{"side":"s"} decoded as %+v, want Square`, s)
	}
	s = Shape{}
	if err := json.Unmarshal([]byte(`{"other":1}`), &s); err != nil {
		t.Fatal(err)
	}
	if s.Circle != nil || s.Square != nil || string(s.Unknown) != `{"other":1}` {
		t.Errorf(`{"other":1} decoded as %+v, want Unknown`, s)
	}
}

func TestShapeRefuses(t *testing.T) {
	for _, in := range []string{
		`{"kind":"circle"}`,                       // r is required
		`{"kind":"circle","r":9223372036854775808}`, // beyond int64
		`{"kind":"square","side":5}`,              // side is a string
		`"circle"`,                                // not an object
	} {
		var s Shape
		if err := json.Unmarshal([]byte(in), &s); err == nil {
			t.Errorf("%s decoded as %+v", in, s)
		}
	}
	if _, err := json.Marshal(Shape{}); err == nil {
		t.Error("an empty Shape encoded")
	}
	if err := (&Shape{}).Validate(); err == nil {
		t.Error("an empty Shape validated")
	}
}

func TestShapeConstructors(t *testing.T) {
	b, err := json.Marshal(NewShapeCircle(5))
	if err != nil {
		t.Fatal(err)
	}
	jsonEqual(t, b, `{"kind":"circle","r":5}`)
	b, err = json.Marshal(NewShapeSquare("s"))
	if err != nil {
		t.Fatal(err)
	}
	jsonEqual(t, b, `{"kind":"square","side":"s"}`)
}
