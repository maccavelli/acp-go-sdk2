{"version": 1, "agentMethods": {}, "clientMethods": {}, "protocolMethods": {"cancel_request": "$/cancel_request"}}
-- schema.json --
{"$defs": {
  "Circle": {"type": "object", "properties": {"kind": {"type": "string", "const": "circle"}, "r": {"type": "integer", "format": "int64"}}, "required": ["kind", "r"]},
  "Square": {"type": "object", "properties": {"kind": {"type": "string", "const": "square"}, "side": {"type": "string"}}, "required": ["kind", "side"]},
  "Shape": {"oneOf": [{"allOf": [{"$ref": "#/$defs/Circle"}], "properties": {"kind": {"type": "string", "const": "circle"}}, "required": ["kind"]}, {"allOf": [{"$ref": "#/$defs/Square"}], "properties": {"kind": {"type": "string", "const": "square"}}, "required": ["kind"]}], "discriminator": {"propertyName": "kind"}},
  "CancelRequestNotification": {"type": "object", "x-side": "protocol", "x-method": "$/cancel_request"}
}}
