One meta key mapped to a stable wire and to a different unstable-only wire
(merge.go, mergeUnstableOnlyMethods).

-- meta.json --
{"version": 1, "agentMethods": {"x": "s/x"}, "clientMethods": {}, "protocolMethods": {"cancel_request": "$/cancel_request"}}
-- schema.json --
{"$defs": {
  "XRequest": {"type": "object", "properties": {}, "x-side": "agent", "x-method": "s/x"},
  "XResponse": {"type": "object", "x-side": "agent", "x-method": "s/x"},
  "CancelRequestNotification": {"type": "object", "x-side": "protocol", "x-method": "$/cancel_request"}
}}
-- meta.unstable.json --
{"version": 1, "agentMethods": {"x": "u/x"}, "clientMethods": {}, "protocolMethods": {"cancel_request": "$/cancel_request"}}
-- schema.unstable.json --
{"$defs": {
  "Thing": {"type": "object", "properties": {"a": {"type": "string"}}},
  "CancelRequestNotification": {"type": "object", "x-side": "protocol", "x-method": "$/cancel_request"}
}}
-- want.err --
method key "x" maps to both "s/x" and "u/x"
