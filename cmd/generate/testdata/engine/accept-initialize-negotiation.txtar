The protocol table's initialize rule: both side connections record the
request and the answer as a Negotiation, a version left zero is the SDK's, and
a client does not send another (0017-MADR-remediate-acp-v1-conformance-violations.md,
N1 and G1).

-- meta.json --
{"version": 1, "agentMethods": {"initialize": "initialize"}, "clientMethods": {}, "protocolMethods": {"cancel_request": "$/cancel_request"}}
-- schema.json --
{"$defs": {
  "ProtocolVersion": {"type": "integer", "format": "uint16"},
  "ClientCapabilities": {"type": "object", "properties": {"fs": {"type": "boolean"}}},
  "AgentCapabilities": {"type": "object", "properties": {"loadSession": {"type": "boolean"}}},
  "InitializeRequest": {"type": "object", "properties": {"protocolVersion": {"$ref": "#/$defs/ProtocolVersion"}, "clientCapabilities": {"$ref": "#/$defs/ClientCapabilities"}}, "required": ["protocolVersion"], "x-side": "agent", "x-method": "initialize"},
  "InitializeResponse": {"type": "object", "properties": {"protocolVersion": {"$ref": "#/$defs/ProtocolVersion"}, "agentCapabilities": {"$ref": "#/$defs/AgentCapabilities"}}, "required": ["protocolVersion"], "x-side": "agent", "x-method": "initialize"},
  "CancelRequestNotification": {"type": "object", "x-side": "protocol", "x-method": "$/cancel_request"}
}}
