-- behaviour_test.go --
package acp

import (
	"context"
	"errors"
	"io"
	"testing"
)

// zeroAgent answers initialize without a version.
type zeroAgent struct{}

func (zeroAgent) Initialize(context.Context, InitializeRequest) (InitializeResponse, error) {
	return InitializeResponse{AgentCapabilities: AgentCapabilities{LoadSession: true}}, nil
}

type noClient struct{}

// Both sides record the exchange, with the zero versions filled; a client
// does not send a version the SDK does not speak.
func TestNegotiation(t *testing.T) {
	ar, cw := io.Pipe()
	cr, aw := io.Pipe()
	t.Cleanup(func() { _ = cw.Close(); _ = aw.Close() })
	asc := NewAgentSideConnection(zeroAgent{}, aw, ar)
	c := NewClientSideConnection(noClient{}, cw, cr)
	if _, ok := c.Negotiated(); ok {
		t.Error("the client has a record before initialize")
	}
	resp, err := c.Initialize(t.Context(), InitializeRequest{ClientCapabilities: ClientCapabilities{Fs: true}})
	if err != nil || resp.ProtocolVersion != ProtocolVersionNumber {
		t.Fatalf("Initialize = %+v, %v, want version %d", resp, err, ProtocolVersionNumber)
	}
	cn, cok := c.Negotiated()
	an, aok := asc.Negotiated()
	if !cok || !aok || cn != an || cn.Request.ProtocolVersion != ProtocolVersionNumber || !cn.Request.ClientCapabilities.Fs ||
		!cn.Response.AgentCapabilities.LoadSession {
		t.Errorf("records: client %+v %v, agent %+v %v", cn, cok, an, aok)
	}
	var pe *ProtocolVersionError
	if _, err := c.Initialize(t.Context(), InitializeRequest{ProtocolVersion: 2}); !errors.As(err, &pe) || pe.Requested != 2 {
		t.Errorf("Initialize(version 2) = %v, want a *ProtocolVersionError", err)
	}
}
