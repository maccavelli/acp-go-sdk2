minimum on integer and number fields is checked by Validate where the Go
type does not enforce it.
The meta declares $/cancel_request and the schema its smallest definition, which
the runtime needs.

-- meta.json --
{"version": 1, "agentMethods": {}, "clientMethods": {}, "protocolMethods": {"cancel_request": "$/cancel_request"}}
-- schema.json --
{"$defs": {
  "Range": {"type": "object", "properties": {"lo": {"type": "integer", "format": "int64", "minimum": 1}, "u": {"type": "integer", "format": "uint32", "minimum": 0}, "r": {"type": "number", "format": "double", "minimum": 0.5}}, "required": ["lo", "u", "r"]},
  "CancelRequestNotification": {"type": "object", "x-side": "protocol", "x-method": "$/cancel_request"}
}}
-- want.api --
type Agent interface{}
type AgentExperimental interface{}
type CancelRequestNotification struct{}
type Client interface{}
type ClientExperimental interface{}
const ProtocolMethodCancelRequest untyped string = "$/cancel_request"
const ProtocolVersionNumber untyped int = 1
type Range struct{Lo int64 "json:\"lo\""; R float64 "json:\"r\""; U uint32 "json:\"u\""}
func (*CancelRequestNotification).Validate() error
func (*Range).UnmarshalJSON(b []byte) error
func (*Range).Validate() error
-- behaviour_test.go --
package acp

import (
	"errors"
	"testing"
)

// minimum is checked on an int64 and on a float64, at the bound and below it.
func TestValidateMinimum(t *testing.T) {
	tests := []struct {
		v    Range
		fail bool
	}{
		{Range{Lo: 1, R: 0.5}, false},
		{Range{Lo: 0, R: 0.5}, true},
		{Range{Lo: 1, R: 0.4}, true},
		{Range{Lo: 9223372036854775807, R: 1e300, U: 4294967295}, false},
	}
	for _, tt := range tests {
		if err := tt.v.Validate(); (err != nil) != tt.fail {
			t.Errorf("%+v: Validate = %v, want failure %v", tt.v, err, tt.fail)
		}
	}
}

// A failed minimum is a *ValidationError naming the type, key, value and
// rule (0015-PLAN-validate-absolute-protocol-paths.md, step 3).
func TestValidateMinimumError(t *testing.T) {
	err := (&Range{Lo: 0, R: 0.5}).Validate()
	var ve *ValidationError
	if !errors.As(err, &ve) || ve.Type != "Range" || ve.Field != "lo" || ve.Value != int64(0) || ve.Rule != RuleMinimum {
		t.Errorf("Validate() = %#v, want a *ValidationError for Range lo 0 minimum", err)
	}
}
