-- behaviour_test.go --
package acp

import (
	"encoding/json"
	"testing"
)

// Each patch field reads an omitted key as absent, null as null, a value as
// that value and a malformed one as absent, and sends each back as it was
// read; the field without a rule keeps reading null as nil.
func TestPatchFieldsThreeStates(t *testing.T) {
	for _, tt := range []struct{ in, want string }{
		{`{}`, `{}`},
		{`{"title":null,"updatedAt":null,"note":null}`, `{"title":null,"updatedAt":null}`},
		{`{"title":"t","updatedAt":"","note":"n"}`, `{"note":"n","title":"t","updatedAt":""}`},
		{`{"title":5,"updatedAt":true}`, `{}`},
	} {
		var u SessionInfoUpdate
		if err := json.Unmarshal([]byte(tt.in), &u); err != nil {
			t.Fatalf("%s: %v", tt.in, err)
		}
		b, err := json.Marshal(u)
		if err != nil || string(b) != tt.want {
			t.Errorf("%s: sent back as %s, %v; want %s", tt.in, b, err, tt.want)
		}
	}
	for _, tt := range []struct{ in, want string }{
		{`{"messageId":"m"}`, `{"messageId":"m"}`},
		{`{"messageId":"m","content":null,"_meta":null}`, `{"_meta":null,"content":null,"messageId":"m"}`},
		{`{"messageId":"m","content":[],"_meta":{}}`, `{"_meta":{},"content":[],"messageId":"m"}`},
		{`{"messageId":"m","content":["a",1,"b"],"_meta":{"k":1}}`, `{"_meta":{"k":1},"content":["a","b"],"messageId":"m"}`},
		{`{"messageId":"m","content":5,"_meta":5}`, `{"messageId":"m"}`},
	} {
		var m SessionMessage
		if err := json.Unmarshal([]byte(tt.in), &m); err != nil {
			t.Fatalf("%s: %v", tt.in, err)
		}
		b, err := json.Marshal(m)
		if err != nil || string(b) != tt.want {
			t.Errorf("%s: sent back as %s, %v; want %s", tt.in, b, err, tt.want)
		}
	}
	m := SessionMessage{MessageId: "m", Content: PatchNull[[]string](), Meta: PatchValue(map[string]any{})}
	if b, _ := json.Marshal(m); string(b) != `{"_meta":{},"content":null,"messageId":"m"}` {
		t.Errorf("a null content and an empty _meta sent as %s", b)
	}
}
