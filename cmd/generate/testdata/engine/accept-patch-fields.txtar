    "content": {"type": ["array", "null"], "items": {"type": "string"}, "x-deserialize-default-on-error": true, "x-deserialize-skip-invalid-items": true},
    "_meta": {"type": ["object", "null"], "additionalProperties": true, "x-deserialize-default-on-error": true}}},
