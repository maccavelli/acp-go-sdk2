-- behaviour_test.go --
package acp

import (
	"encoding/json"
	"testing"
)

// tags, which the rule names, sends an empty slice as [] and omits a nil one;
// notes, which no rule names, omits both.
func TestEmptyClears(t *testing.T) {
	for _, tt := range []struct {
		in   Opts
		want string
	}{
		{Opts{Tags: []string{}, Notes: []string{}}, `{"tags":[]}`},
		{Opts{}, `{}`},
		{Opts{Tags: []string{"a"}}, `{"tags":["a"]}`},
	} {
		b, err := json.Marshal(tt.in)
		if err != nil || string(b) != tt.want {
			t.Errorf("%+v sent as %s, %v; want %s", tt.in, b, err, tt.want)
		}
	}
}
