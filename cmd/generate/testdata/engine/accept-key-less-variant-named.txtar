-- behaviour_test.go --
package acp

import (
	"encoding/json"
	"strings"
	"testing"
)

func whichU(u U) string {
	switch {
	case u.A != nil:
		return "A"
	case u.Loose != nil:
		return "Loose"
	case u.Unknown != nil:
		return "Unknown"
	}
	return "none"
}

func whichC(c C) string {
	switch {
	case c.A != nil:
		return "A"
	case c.Other != nil:
		return "Other " + c.Other.Type
	case c.Plain != nil:
		return "Plain"
	}
	return "none"
}

// The own name decodes into the key-less variant; another unknown type is
// kept; without a type the key-less variant is tried by its keys.
func TestOwnName(t *testing.T) {
	for in, want := range map[string]string{
		`{"type":"a"}`:           "A",
		`{"type":"loose","x":"v"}`: "Loose",
		`{"x":"v"}`:              "Loose",
		`{"type":"q","x":"v"}`:   "Unknown",
	} {
		var u U
		if err := json.Unmarshal([]byte(in), &u); err != nil {
			t.Fatalf("%s: %v", in, err)
		}
		if got := whichU(u); got != want {
			t.Errorf("%s decoded as %s, want %s", in, got, want)
		}
	}
}

// The own name is strict: a payload it does not decode as is an error that
// names the value, not a payload kept in Unknown.
func TestOwnNameStrict(t *testing.T) {
	var u U
	err := json.Unmarshal([]byte(`{"type":"loose"}`), &u)
	if err == nil || !strings.Contains(err.Error(), `U: type "loose"`) {
		t.Errorf(`{"type":"loose"} = %v, decoded as %s; want an error naming U: type "loose"`, err, whichU(u))
	}
}

// In a union with a catch-all, the key-less variant's title goes to the
// catch-all, as any value no variant names does.
func TestCatchAllKeepsTheTitle(t *testing.T) {
	for in, want := range map[string]string{
		`{"type":"plain","y":"1"}`: "Other plain",
		`{"y":"1"}`:                "Plain",
	} {
		var c C
		if err := json.Unmarshal([]byte(in), &c); err != nil {
			t.Fatalf("%s: %v", in, err)
		}
		if got := whichC(c); got != want {
			t.Errorf("%s decoded as %s, want %s", in, got, want)
		}
	}
}
