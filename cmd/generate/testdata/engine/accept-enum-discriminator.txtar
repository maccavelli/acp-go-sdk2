-- behaviour_test.go --
package acp

import (
	"encoding/json"
	"testing"
)

// Each payload routes to the variant whose enum holds its kind.
func TestEnumDiscriminator(t *testing.T) {
	var s Shape
	if err := json.Unmarshal([]byte(`{"kind":"circle","r":1}`), &s); err != nil || s.Circle == nil || s.Circle.R != 1 || s.Unknown != nil {
		t.Errorf("circle decoded as %+v, %v", s, err)
	}
	s = Shape{}
	if err := json.Unmarshal([]byte(`{"kind":"square","s":2}`), &s); err != nil || s.Square == nil || s.Square.S != 2 || s.Unknown != nil {
		t.Errorf("square decoded as %+v, %v", s, err)
	}
}
