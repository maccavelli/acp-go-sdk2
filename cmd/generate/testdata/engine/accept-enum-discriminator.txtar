A union whose declared discriminator each variant fixes with a one-value enum, not
a const: the one value is the variant's, so a payload routes to it, where every
payload decoded into Unknown (0049-MADR-remediate-the-2026-11-01-debugging-pass.md, G21, Q26 a).

-- meta.json --
{"version": 1, "agentMethods": {}, "clientMethods": {}, "protocolMethods": {"cancel_request": "$/cancel_request"}}
-- schema.json --
{"$defs": {
  "Shape": {"oneOf": [{"title": "Circle", "type": "object", "properties": {"kind": {"type": "string", "enum": ["circle"]}, "r": {"type": "integer", "format": "int32"}}, "required": ["kind"]}, {"title": "Square", "type": "object", "properties": {"kind": {"type": "string", "enum": ["square"]}, "s": {"type": "integer", "format": "int32"}}, "required": ["kind"]}], "discriminator": {"propertyName": "kind"}},
  "CancelRequestNotification": {"type": "object", "x-side": "protocol", "x-method": "$/cancel_request"}
}}
