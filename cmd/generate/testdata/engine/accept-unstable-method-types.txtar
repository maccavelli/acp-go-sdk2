-- behaviour_test.go --
package acp_test

import (
	"context"
	"errors"
	"io"
	"testing"

	acp "enginetest/accept-unstable-method-types"
	"enginetest/accept-unstable-method-types/unstable"
)

type stableAgent struct{}

func (stableAgent) Old(context.Context, acp.OldRequest) (acp.OldResponse, error) { return acp.OldResponse{}, nil }

// A new unstable method is not acp's: sent with package unstable's constant
// and request, acp's dispatch answers it method not found.
func TestNewMethodNotDispatched(t *testing.T) {
	ar, cw := io.Pipe()
	cr, aw := io.Pipe()
	t.Cleanup(func() { _ = cw.Close(); _ = aw.Close() })
	_ = acp.NewAgentSideConnection(stableAgent{}, aw, ar)
	c := acp.NewClientSideConnection(struct{}{}, cw, cr)
	req := unstable.PingRequest{S: acp.Shared{A: "a"}, Label: "x"}
	err := c.Connection().SendRequestNoResult(t.Context(), unstable.AgentMethodPing, req)
	var re *acp.RequestError
	if !errors.As(err, &re) || re.Code != -32601 {
		t.Fatalf("%s: %v, want method not found", unstable.AgentMethodPing, err)
	}
}

// A check of package unstable returns acp's ValidationError, without the
// message only acp can set, so its text is the fallback "Type: Field: Rule"
// (0039-MADR-five-adopter-additions-on-schema-1-25-0.md, question 9).
func TestUnstableValidationError(t *testing.T) {
	err := (&unstable.PingRequest{}).Validate()
	var ve *acp.ValidationError
	if !errors.As(err, &ve) || ve.Type != "PingRequest" || ve.Field != "label" || ve.Rule != acp.RuleMinLength {
		t.Fatalf("Validate: %v (%#v), want acp's ValidationError for label's minLength", err, ve)
	}
	if want := "PingRequest: label: " + string(acp.RuleMinLength); err.Error() != want {
		t.Errorf("text %q, want %q", err.Error(), want)
	}
}
