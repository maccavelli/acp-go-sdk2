-- behaviour_test.go --
package acp

import (
	"encoding/json"
	"errors"
	"slices"
	"strings"
	"testing"
)

// TestAcceptedAuthMethodIDs requires the emitted list of the ids authenticate
// accepts to hold, in the answer's order and each once, the agent ids and an
// Unknown entry's string id, and no id a terminal entry names, even one an
// agent entry also names; and the gate to refuse a terminal id as terminal and
// any id the list lacks as unadvertised, naming the list, or "none".
func TestAcceptedAuthMethodIDs(t *testing.T) {
	entry := func(raw string) AuthMethod {
		var a AuthMethod
		if err := json.Unmarshal([]byte(raw), &a); err != nil {
			t.Fatalf("%s: %v", raw, err)
		}
		return a
	}
	list := []AuthMethod{
		entry(`{"id":"a","name":"A"}`),
		entry(`{"type":"terminal","id":"t","name":"T"}`),
		entry(`{"id":"t","name":"T, agent"}`),
		entry(`{"type":"x","id":"u","name":"U"}`),
		entry(`{"type":"x","name":"V"}`),
		entry(`{"id":"a","name":"A again"}`),
	}
	if list[3].Unknown == nil || list[4].Unknown == nil {
		t.Fatalf("the type x entries decoded as %+v and %+v, want Unknown", list[3], list[4])
	}
	if got := acceptedAuthenticateRequestMethodIds(list); !slices.Equal(got, []AuthMethodId{"a", "u"}) {
		t.Errorf("accepted ids = %q, want [a u]", got)
	}
	n := &Negotiation{Response: InitializeResponse{AuthMethods: list}}
	gate := func(n *Negotiation, id AuthMethodId) error {
		return (&AuthenticateRequest{MethodId: id}).gates(n, "authenticate")
	}
	if err := gate(n, "t"); !errors.Is(err, ErrTerminalAuthMethod) {
		t.Errorf("t, terminal and agent: %v, want ErrTerminalAuthMethod", err)
	}
	for _, id := range []AuthMethodId{"unknown", "z"} {
		err := gate(n, id)
		if !errors.Is(err, ErrUnadvertisedAuthMethod) || err == nil || !strings.HasSuffix(err.Error(), `; authenticate accepts "a", "u"`) {
			t.Errorf("%s: %v, want ErrUnadvertisedAuthMethod naming a and u", id, err)
		}
	}
	for _, id := range []AuthMethodId{"a", "u"} {
		if err := gate(n, id); err != nil {
			t.Errorf("%s: %v, want nil", id, err)
		}
	}
	if err := gate(&Negotiation{}, "a"); err == nil || !strings.HasSuffix(err.Error(), "; authenticate accepts none") {
		t.Errorf("a, with no methods: %v, want the refusal to name none", err)
	}
}
