-- behaviour_test.go --
package acp

import (
	"encoding/json"
	"testing"
)

func TestPairAfterNullMember(t *testing.T) {
	var p Pair
	if err := json.Unmarshal([]byte(`{"b":"x"}`), &p); err != nil || p.Right == nil || p.Right.B != "x" {
		t.Errorf(`{"b":"x"} decoded as %+v, %v; want Right`, p, err)
	}
	if r := NewPairRight("x"); r.Right == nil || r.Right.B != "x" {
		t.Errorf("NewPairRight(x) = %+v", r)
	}
}
