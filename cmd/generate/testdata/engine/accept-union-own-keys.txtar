-- behaviour_test.go --
package acp

import (
	"encoding/json"
	"testing"
)

// The constructors set the union's own keys, the variant's, and the
// discriminator, and the value decodes back to its variant.
func TestUnionOwnKeys(t *testing.T) {
	b, err := json.Marshal(NewOptB("i", "n"))
	if err != nil || string(b) != `{"id":"i","name":"n","type":"b"}` {
		t.Fatalf("NewOptB encoded as %s, %v", b, err)
	}
	var o Opt
	if err := json.Unmarshal(b, &o); err != nil || o.B == nil || o.B.Id != "i" || o.B.Name != "n" {
		t.Errorf("%s decoded as %+v, %v", b, o, err)
	}
	if b, err := json.Marshal(NewOptA("i", "n", 5)); err != nil || string(b) != `{"id":"i","name":"n","type":"a","value":5}` {
		t.Errorf("NewOptA encoded as %s, %v", b, err)
	}
}
