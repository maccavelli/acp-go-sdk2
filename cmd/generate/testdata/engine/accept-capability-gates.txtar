{"$defs": {
  "ProtocolVersion": {"type": "integer", "format": "uint16"},
  "Flag": {"type": "object"},
  "SessionCapabilities": {"type": "object", "properties": {"additionalDirectories": {"anyOf": [{"$ref": "#/$defs/Flag"}, {"type": "null"}]}}},
  "PromptCapabilities": {"type": "object", "properties": {"image": {"type": "boolean"}, "audio": {"type": "boolean"}, "embeddedContext": {"type": "boolean"}}},
  "AgentCapabilities": {"type": "object", "properties": {"sessionCapabilities": {"$ref": "#/$defs/SessionCapabilities"}, "promptCapabilities": {"$ref": "#/$defs/PromptCapabilities"}}},
  "ClientSessionCapabilities": {"type": "object", "properties": {"notices": {"anyOf": [{"$ref": "#/$defs/Flag"}, {"type": "null"}]}, "compaction": {"anyOf": [{"$ref": "#/$defs/Flag"}, {"type": "null"}]}}},
  "ClientCapabilities": {"type": "object", "properties": {"session": {"anyOf": [{"$ref": "#/$defs/ClientSessionCapabilities"}, {"type": "null"}]}, "subagents": {"anyOf": [{"$ref": "#/$defs/Flag"}, {"type": "null"}]}}},
  "InitializeRequest": {"type": "object", "properties": {"protocolVersion": {"$ref": "#/$defs/ProtocolVersion"}, "clientCapabilities": {"$ref": "#/$defs/ClientCapabilities"}}, "required": ["protocolVersion"], "x-side": "agent", "x-method": "initialize"},
  "InitializeResponse": {"type": "object", "properties": {"protocolVersion": {"$ref": "#/$defs/ProtocolVersion"}, "agentCapabilities": {"$ref": "#/$defs/AgentCapabilities"}}, "required": ["protocolVersion"], "x-side": "agent", "x-method": "initialize"},
  "NewSessionRequest": {"type": "object", "properties": {"additionalDirectories": {"type": "array", "items": {"type": "string"}}}, "x-side": "agent", "x-method": "x/new"},
  "NewSessionResponse": {"type": "object", "x-side": "agent", "x-method": "x/new"},
  "ContentBlock": {"oneOf": [
    {"type": "object", "required": ["type", "text"], "properties": {"type": {"const": "text", "type": "string"}, "text": {"type": "string"}}},
    {"type": "object", "required": ["type", "data"], "properties": {"type": {"const": "image", "type": "string"}, "data": {"type": "string"}}},
    {"type": "object", "required": ["type", "data"], "properties": {"type": {"const": "audio", "type": "string"}, "data": {"type": "string"}}},
    {"type": "object", "required": ["type", "uri"], "properties": {"type": {"const": "resource", "type": "string"}, "uri": {"type": "string"}}}
  ], "discriminator": {"propertyName": "type"}},
  "PromptRequest": {"type": "object", "properties": {"prompt": {"type": "array", "items": {"$ref": "#/$defs/ContentBlock"}}}, "required": ["prompt"], "x-side": "agent", "x-method": "x/prompt"},
  "PromptResponse": {"type": "object", "x-side": "agent", "x-method": "x/prompt"},
  "SessionUpdate": {"oneOf": [
    {"type": "object", "required": ["sessionUpdate", "text"], "properties": {"sessionUpdate": {"const": "agent_message_chunk", "type": "string"}, "text": {"type": "string"}}},
    {"type": "object", "required": ["sessionUpdate", "text"], "properties": {"sessionUpdate": {"const": "notice", "type": "string"}, "text": {"type": "string"}}},
    {"type": "object", "required": ["sessionUpdate"], "properties": {"sessionUpdate": {"const": "compaction_update", "type": "string"}}},
    {"type": "object", "required": ["sessionUpdate", "text"], "properties": {"sessionUpdate": {"const": "compaction_summary_chunk", "type": "string"}, "text": {"type": "string"}}},
    {"type": "object", "required": ["sessionUpdate"], "properties": {"sessionUpdate": {"const": "subagent_update", "type": "string"}}},
    {"type": "object", "required": ["sessionUpdate"], "properties": {"sessionUpdate": {"const": "session_message", "type": "string"}}},
    {"type": "object", "required": ["sessionUpdate"], "properties": {"sessionUpdate": {"const": "session_message_chunk", "type": "string"}}}
  ], "discriminator": {"propertyName": "sessionUpdate"}},
  "SessionNotification": {"type": "object", "properties": {"update": {"$ref": "#/$defs/SessionUpdate"}}, "required": ["update"], "x-side": "client", "x-method": "x/update"},
  "CancelRequestNotification": {"type": "object", "x-side": "protocol", "x-method": "$/cancel_request"}
}}
