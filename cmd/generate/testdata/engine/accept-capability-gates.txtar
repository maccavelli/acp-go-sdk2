-- behaviour_test.go --
package acp

import (
	"context"
	"errors"
	"io"
	"testing"
	"time"
)

// gateAgent advertises caps and reports each handled request on calls.
type gateAgent struct {
	caps  AgentCapabilities
	calls chan string
}

func (a gateAgent) Initialize(context.Context, InitializeRequest) (InitializeResponse, error) {
	return InitializeResponse{AgentCapabilities: a.caps}, nil
}

func (a gateAgent) NewSession(context.Context, NewSessionRequest) (NewSessionResponse, error) {
	a.calls <- "new"
	return NewSessionResponse{}, nil
}

func (a gateAgent) Prompt(context.Context, PromptRequest) (PromptResponse, error) {
	a.calls <- "prompt"
	return PromptResponse{}, nil
}

// gateClient reports each delivered update on calls.
type gateClient struct{ calls chan string }

func (c gateClient) Session(_ context.Context, n SessionNotification) error {
	if n.Update.Notice != nil {
		c.calls <- "notice"
	} else {
		c.calls <- "chunk"
	}
	return nil
}

// gatePair connects an agent advertising agent and a client advertising
// client, and initializes; it returns where each reports its calls.
func gatePair(t *testing.T, agent AgentCapabilities, client ClientCapabilities) (*AgentSideConnection, *ClientSideConnection, chan string, chan string) {
	t.Helper()
	ar, cw := io.Pipe()
	cr, aw := io.Pipe()
	t.Cleanup(func() { _ = cw.Close(); _ = aw.Close() })
	ac, cc := make(chan string, 4), make(chan string, 4)
	asc := NewAgentSideConnection(gateAgent{agent, ac}, aw, ar)
	csc := NewClientSideConnection(gateClient{cc}, cw, cr)
	if _, err := csc.Initialize(t.Context(), InitializeRequest{ClientCapabilities: client}); err != nil {
		t.Fatal(err)
	}
	return asc, csc, ac, cc
}

// next returns the next call on ch.
func next(t *testing.T, ch chan string) string {
	t.Helper()
	select {
	case s := <-ch:
		return s
	case <-time.After(5 * time.Second):
		t.Fatal("no call")
		return ""
	}
}

func prompt() PromptRequest {
	return PromptRequest{Prompt: []ContentBlock{
		{Text: &ContentBlockText{Type: "text", Text: "hi"}},
		{Image: &ContentBlockImage{Type: "image", Data: "x"}},
	}}
}

func notice() SessionNotification {
	return SessionNotification{Update: SessionUpdate{Notice: &SessionUpdateNotice{SessionUpdate: "notice", Text: "n"}}}
}

func chunk() SessionNotification {
	return SessionNotification{Update: SessionUpdate{AgentMessageChunk: &SessionUpdateAgentMessageChunk{SessionUpdate: "agent_message_chunk", Text: "c"}}}
}

// Without the capabilities, each gated value is refused before it is sent,
// with the property or variant named, and refused when it is received.
func TestGatesRefuse(t *testing.T) {
	asc, csc, ac, cc := gatePair(t, AgentCapabilities{}, ClientCapabilities{})
	dirs := NewSessionRequest{AdditionalDirectories: []string{t.TempDir()}}
	var ce *CapabilityError
	if _, err := csc.NewSession(t.Context(), dirs); !errors.As(err, &ce) || ce.Field != "additionalDirectories" ||
		ce.Capability != "sessionCapabilities.additionalDirectories" || ce.Method != AgentMethodNew {
		t.Errorf("NewSession = %v", err)
	}
	if _, err := csc.Prompt(t.Context(), prompt()); !errors.As(err, &ce) || ce.Field != "prompt[1]" || ce.Variant != "image" ||
		ce.Capability != "promptCapabilities.image" {
		t.Errorf("Prompt = %v", err)
	}
	if err := asc.Session(t.Context(), notice()); !errors.As(err, &ce) || ce.Variant != "notice" || ce.Capability != "session.notices" {
		t.Errorf("Session = %v", err)
	}
	if _, err := csc.NewSession(t.Context(), NewSessionRequest{}); err != nil {
		t.Fatal(err)
	}
	if got := next(t, ac); got != "new" {
		t.Errorf("the agent handled %q first, want the ungated new", got)
	}

	var re *RequestError
	if _, err := SendRequest[NewSessionResponse](csc.Connection(), t.Context(), AgentMethodNew, dirs); !errors.As(err, &re) || re.Code != -32602 {
		t.Errorf("a raw new with directories = %v, want -32602", err)
	}
	if err := asc.Connection().SendNotification(t.Context(), ClientMethodUpdate, notice()); err != nil {
		t.Fatal(err)
	}
	if err := asc.Session(t.Context(), chunk()); err != nil {
		t.Fatal(err)
	}
	if got := next(t, cc); got != "chunk" {
		t.Errorf("the client was delivered %q first, want the chunk after the dropped notice", got)
	}
	if len(ac) != 0 {
		t.Errorf("the agent handled %q", <-ac)
	}
}

// With the capabilities, each is sent and handled.
func TestGatesAllow(t *testing.T) {
	asc, csc, ac, cc := gatePair(t,
		AgentCapabilities{SessionCapabilities: SessionCapabilities{AdditionalDirectories: &Flag{}}, PromptCapabilities: PromptCapabilities{Image: true}},
		ClientCapabilities{Session: &ClientSessionCapabilities{Notices: &Flag{}}})
	if _, err := csc.NewSession(t.Context(), NewSessionRequest{AdditionalDirectories: []string{t.TempDir()}}); err != nil || next(t, ac) != "new" {
		t.Errorf("NewSession = %v", err)
	}
	if _, err := csc.Prompt(t.Context(), prompt()); err != nil || next(t, ac) != "prompt" {
		t.Errorf("Prompt = %v", err)
	}
	if err := asc.Session(t.Context(), notice()); err != nil || next(t, cc) != "notice" {
		t.Errorf("Session = %v", err)
	}
}
