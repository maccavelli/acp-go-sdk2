A value-less variant with not.required of the discriminator is the
catch-all: no Unknown field, and the variant keeps Extra.
The meta declares $/cancel_request and the schema its smallest definition, which
the runtime needs.

-- meta.json --
{"version": 1, "agentMethods": {}, "clientMethods": {}, "protocolMethods": {"cancel_request": "$/cancel_request"}}
-- schema.json --
{"$defs": {
  "U": {"anyOf": [{"type": "object", "properties": {"type": {"type": "string", "const": "a"}, "x": {"type": "string"}}, "required": ["type"]}, {"title": "other", "type": "object", "required": ["type"], "properties": {"type": {"type": "string"}}, "not": {"anyOf": [{"type": "object", "properties": {"type": {"type": "string", "const": "a"}}, "required": ["type"]}]}}]},
  "CancelRequestNotification": {"type": "object", "x-side": "protocol", "x-method": "$/cancel_request"}
}}
-- want.api --
type Agent interface{}
type AgentExperimental interface{}
type AgentSideConnection struct{conn *Connection; agent Agent}
type CancelRequestNotification struct{}
type Client interface{}
type ClientExperimental interface{}
type ClientSideConnection struct{conn *Connection; client Client}
func NewAgentSideConnection(agent Agent, peerInput io.Writer, peerOutput io.Reader, opts ...ConnectionOption) *AgentSideConnection
func NewClientSideConnection(client Client, peerInput io.Writer, peerOutput io.Reader, opts ...ConnectionOption) *ClientSideConnection
func NewUA() U
func NewUOther(typeValue string) U
const ProtocolMethodCancelRequest untyped string = "$/cancel_request"
const ProtocolVersionNumber untyped int = 1
type U struct{A *UA "json:\"-\""; Other *UOther "json:\"-\""}
type UA struct{Type string "json:\"type\""; X string "json:\"x,omitempty\""}
type UOther struct{Type string "json:\"type\""; Extra map[string]json.RawMessage "json:\"-\""}
func (*AgentSideConnection).Close() error
func (*AgentSideConnection).Connection() *Connection
func (*AgentSideConnection).Done() <-chan struct{}
func (*AgentSideConnection).DroppedNotifications() uint64
func (*AgentSideConnection).SetLogger(l *slog.Logger)
func (*CancelRequestNotification).Validate() error
func (*ClientSideConnection).Close() error
func (*ClientSideConnection).Connection() *Connection
func (*ClientSideConnection).Done() <-chan struct{}
func (*ClientSideConnection).DroppedNotifications() uint64
func (*ClientSideConnection).SetLogger(l *slog.Logger)
func (U).MarshalJSON() ([]byte, error)
func (*U).UnmarshalJSON(b []byte) error
func (*U).Validate() error
func (UOther).MarshalJSON() ([]byte, error)
func (*UOther).UnmarshalJSON(b []byte) error
-- behaviour_test.go --
package acp

import (
	"bytes"
	"encoding/json"
	"reflect"
	"strings"
	"testing"
)

func jsonEqual(t *testing.T, got []byte, want string) {
	t.Helper()
	decode := func(b []byte) any {
		d := json.NewDecoder(bytes.NewReader(b))
		d.UseNumber()
		var v any
		if err := d.Decode(&v); err != nil {
			t.Fatalf("%s: %v", b, err)
		}
		return v
	}
	if !reflect.DeepEqual(decode(got), decode([]byte(want))) {
		t.Errorf("got %s, want %s", got, want)
	}
}

// A type no variant names goes to the catch-all, which keeps every other key
// in Extra and sends it back unchanged.
func TestCatchAll(t *testing.T) {
	var u U
	in := `{"type":"zzz","y":1,"z":{"deep":[true]}}`
	if err := json.Unmarshal([]byte(in), &u); err != nil {
		t.Fatal(err)
	}
	if u.A != nil || u.Other == nil || u.Other.Type != "zzz" || string(u.Other.Extra["y"]) != "1" {
		t.Fatalf("decoded as %+v (other %+v)", u, u.Other)
	}
	b, err := json.Marshal(u)
	if err != nil {
		t.Fatal(err)
	}
	jsonEqual(t, b, in)

	u = U{}
	if err := json.Unmarshal([]byte(`{"type":"a","x":"1"}`), &u); err != nil {
		t.Fatal(err)
	}
	if u.A == nil || u.A.X != "1" || u.Other != nil {
		t.Errorf("a decoded as %+v", u)
	}
}

// The catch-all's constructor takes its discriminator. Validate refuses a
// value its not excludes, which the peer would read as A; another value
// validates and keeps the catch-all, Extra included
// (0014-MADR-union-constructors-take-every-required-key.md, C1 and X1).
func TestCatchAllConstructor(t *testing.T) {
	err := func() error { u := NewUOther("a"); return u.Validate() }()
	if err == nil || !strings.Contains(err.Error(), "U") || !strings.Contains(err.Error(), "type") || !strings.Contains(err.Error(), `"a"`) {
		t.Errorf("NewUOther(\"a\").Validate() = %v, want an error naming U, type and \"a\"", err)
	}
	u := NewUOther("_x")
	u.Other.Extra = map[string]json.RawMessage{"y": json.RawMessage(`1`)}
	if err := u.Validate(); err != nil {
		t.Fatalf("NewUOther(\"_x\").Validate() = %v", err)
	}
	b, err := json.Marshal(u)
	if err != nil {
		t.Fatal(err)
	}
	jsonEqual(t, b, `{"type":"_x","y":1}`)
	var back U
	if err := json.Unmarshal(b, &back); err != nil || back.Other == nil || back.Other.Type != "_x" || string(back.Other.Extra["y"]) != "1" {
		t.Errorf("%s decoded as %+v, %v", b, back, err)
	}
}
