A value-less variant with not.required of the discriminator is the
catch-all: no Unknown field, and the variant keeps Extra.
The meta declares $/cancel_request and the schema its smallest definition, which
the runtime needs.

-- meta.json --
{"version": 1, "agentMethods": {}, "clientMethods": {}, "protocolMethods": {"cancel_request": "$/cancel_request"}}
-- schema.json --
{"$defs": {
  "U": {"anyOf": [{"type": "object", "properties": {"type": {"type": "string", "const": "a"}, "x": {"type": "string"}}, "required": ["type"]}, {"title": "other", "type": "object", "required": ["type"], "properties": {"type": {"type": "string"}}, "not": {"required": ["type"]}}]},
  "CancelRequestNotification": {"type": "object", "x-side": "protocol", "x-method": "$/cancel_request"}
}}
-- want.api --
type Agent interface{}
type AgentExperimental interface{}
type CancelRequestNotification struct{}
type Client interface{}
type ClientExperimental interface{}
const ProtocolMethodCancelRequest untyped string = "$/cancel_request"
const ProtocolVersionNumber untyped int = 1
type U struct{A *UA "json:\"-\""; Other *UOther "json:\"-\""}
type UA struct{Type string "json:\"type\""; X string "json:\"x,omitempty\""}
type UOther struct{Type string "json:\"type\""; Extra map[string]json.RawMessage "json:\"-\""}
func (*CancelRequestNotification).Validate() error
func (U).MarshalJSON() ([]byte, error)
func (*U).UnmarshalJSON(b []byte) error
func (*U).Validate() error
func (UOther).MarshalJSON() ([]byte, error)
func (*UOther).UnmarshalJSON(b []byte) error
-- behaviour_test.go --
package acp

import (
	"bytes"
	"encoding/json"
	"reflect"
	"testing"
)

func jsonEqual(t *testing.T, got []byte, want string) {
	t.Helper()
	decode := func(b []byte) any {
		d := json.NewDecoder(bytes.NewReader(b))
		d.UseNumber()
		var v any
		if err := d.Decode(&v); err != nil {
			t.Fatalf("%s: %v", b, err)
		}
		return v
	}
	if !reflect.DeepEqual(decode(got), decode([]byte(want))) {
		t.Errorf("got %s, want %s", got, want)
	}
}

// A type no variant names goes to the catch-all, which keeps every other key
// in Extra and sends it back unchanged.
func TestCatchAll(t *testing.T) {
	var u U
	in := `{"type":"zzz","y":1,"z":{"deep":[true]}}`
	if err := json.Unmarshal([]byte(in), &u); err != nil {
		t.Fatal(err)
	}
	if u.A != nil || u.Other == nil || u.Other.Type != "zzz" || string(u.Other.Extra["y"]) != "1" {
		t.Fatalf("decoded as %+v (other %+v)", u, u.Other)
	}
	b, err := json.Marshal(u)
	if err != nil {
		t.Fatal(err)
	}
	jsonEqual(t, b, in)

	u = U{}
	if err := json.Unmarshal([]byte(`{"type":"a","x":"1"}`), &u); err != nil {
		t.Fatal(err)
	}
	if u.A == nil || u.A.X != "1" || u.Other != nil {
		t.Errorf("a decoded as %+v", u)
	}
}
