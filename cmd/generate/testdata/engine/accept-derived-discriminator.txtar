Without a discriminator keyword, the first const property of the variants
discriminates.
The meta declares $/cancel_request and the schema its smallest definition, which
the runtime needs.

-- meta.json --
{"version": 1, "agentMethods": {}, "clientMethods": {}, "protocolMethods": {"cancel_request": "$/cancel_request"}}
-- schema.json --
{"$defs": {
  "Event": {"oneOf": [{"type": "object", "properties": {"event": {"type": "string", "const": "start"}, "at": {"type": "string"}}, "required": ["event", "at"]}, {"type": "object", "properties": {"event": {"type": "string", "const": "stop"}}, "required": ["event"]}]},
  "CancelRequestNotification": {"type": "object", "x-side": "protocol", "x-method": "$/cancel_request"}
}}
-- want.api --
type Agent interface{}
type AgentExperimental interface{}
type AgentSideConnection struct{conn *Connection; agent Agent}
type CancelRequestNotification struct{}
type Client interface{}
type ClientExperimental interface{}
type ClientSideConnection struct{conn *Connection; client Client}
type Event struct{Start *EventStart "json:\"-\""; Stop *EventStop "json:\"-\""; Unknown json.RawMessage "json:\"-\""}
type EventStart struct{At string "json:\"at\""; Event string "json:\"event\""}
type EventStop struct{Event string "json:\"event\""}
func NewAgentSideConnection(agent Agent, peerInput io.Writer, peerOutput io.Reader, opts ...ConnectionOption) *AgentSideConnection
func NewClientSideConnection(client Client, peerInput io.Writer, peerOutput io.Reader, opts ...ConnectionOption) *ClientSideConnection
func NewEventStart(at string) Event
func NewEventStop() Event
const ProtocolMethodCancelRequest untyped string = "$/cancel_request"
const ProtocolVersionNumber untyped int = 1
func (*AgentSideConnection).Connection() *Connection
func (*AgentSideConnection).Done() <-chan struct{}
func (*AgentSideConnection).DroppedNotifications() uint64
func (*AgentSideConnection).SetLogger(l *slog.Logger)
func (*CancelRequestNotification).Validate() error
func (*ClientSideConnection).Connection() *Connection
func (*ClientSideConnection).Done() <-chan struct{}
func (*ClientSideConnection).DroppedNotifications() uint64
func (*ClientSideConnection).SetLogger(l *slog.Logger)
func (Event).MarshalJSON() ([]byte, error)
func (*Event).UnmarshalJSON(b []byte) error
func (*Event).Validate() error
func (*EventStart).UnmarshalJSON(b []byte) error
-- behaviour_test.go --
package acp

import (
	"bytes"
	"encoding/json"
	"reflect"
	"testing"
)

func jsonEqual(t *testing.T, got []byte, want string) {
	t.Helper()
	decode := func(b []byte) any {
		d := json.NewDecoder(bytes.NewReader(b))
		d.UseNumber()
		var v any
		if err := d.Decode(&v); err != nil {
			t.Fatalf("%s: %v", b, err)
		}
		return v
	}
	if !reflect.DeepEqual(decode(got), decode([]byte(want))) {
		t.Errorf("got %s, want %s", got, want)
	}
}

// The derived discriminator, event, picks the variant; an unknown event is
// kept and sent back unchanged.
func TestEventRoundTrip(t *testing.T) {
	for in, want := range map[string]string{
		`{"event":"start","at":"t"}`:  "Start",
		`{"event":"stop"}`:            "Stop",
		`{"event":"pause","for":"1s"}`: "Unknown",
	} {
		var e Event
		if err := json.Unmarshal([]byte(in), &e); err != nil {
			t.Fatalf("%s: %v", in, err)
		}
		got := map[bool]string{e.Start != nil: "Start", e.Stop != nil: "Stop", e.Unknown != nil: "Unknown"}[true]
		if got != want {
			t.Errorf("%s decoded as %s, want %s", in, got, want)
		}
		b, err := json.Marshal(e)
		if err != nil {
			t.Fatal(err)
		}
		jsonEqual(t, b, in)
	}
	if err := json.Unmarshal([]byte(`{"event":"start"}`), new(Event)); err == nil {
		t.Error("a start event without its required at decoded")
	}
	b, err := json.Marshal(NewEventStart("t"))
	if err != nil {
		t.Fatal(err)
	}
	jsonEqual(t, b, `{"event":"start","at":"t"}`)
}
