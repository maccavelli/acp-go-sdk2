An object with properties and additionalProperties true keeps the keys it
does not declare in Extra, as received, and sends them back; false, or no
additionalProperties, keeps none (0019-PLAN-generator-hardening.md, G2).
The meta declares $/cancel_request and the schema its smallest definition, which
the runtime needs.

-- meta.json --
{"version": 1, "agentMethods": {}, "clientMethods": {}, "protocolMethods": {"cancel_request": "$/cancel_request"}}
-- schema.json --
{"$defs": {
  "Open": {"type": "object", "properties": {"code": {"type": "integer", "format": "int32"}, "note": {"type": "string"}}, "required": ["code"], "additionalProperties": true},
  "Closed": {"type": "object", "properties": {"code": {"type": "integer", "format": "int32"}}, "required": ["code"], "additionalProperties": false},
  "Plain": {"type": "object", "properties": {"code": {"type": "integer", "format": "int32"}}, "required": ["code"]},
  "CancelRequestNotification": {"type": "object", "x-side": "protocol", "x-method": "$/cancel_request"}
}}
-- want.api --
type Agent interface{}
type AgentExperimental interface{}
type AgentSideConnection struct{conn *Connection; agent Agent}
type CancelRequestNotification struct{}
type Client interface{}
type ClientExperimental interface{}
type ClientSideConnection struct{conn *Connection; client Client}
type Closed struct{Code int32 "json:\"code\""}
func NewAgentSideConnection(agent Agent, peerInput io.Writer, peerOutput io.Reader, opts ...ConnectionOption) *AgentSideConnection
func NewClientSideConnection(client Client, peerInput io.Writer, peerOutput io.Reader, opts ...ConnectionOption) *ClientSideConnection
type Open struct{Code int32 "json:\"code\""; Note string "json:\"note,omitempty\""; Extra map[string]json.RawMessage "json:\"-\""}
type Plain struct{Code int32 "json:\"code\""}
const ProtocolMethodCancelRequest untyped string = "$/cancel_request"
const ProtocolVersionNumber untyped int = 1
func (*AgentSideConnection).Close() error
func (*AgentSideConnection).Connection() *Connection
func (*AgentSideConnection).Done() <-chan struct{}
func (*AgentSideConnection).DroppedNotifications() uint64
func (*AgentSideConnection).Err() error
func (*AgentSideConnection).SetLogger(l *slog.Logger)
func (*AgentSideConnection).Wait() error
func (*CancelRequestNotification).Validate() error
func (*ClientSideConnection).Close() error
func (*ClientSideConnection).Connection() *Connection
func (*ClientSideConnection).Done() <-chan struct{}
func (*ClientSideConnection).DroppedNotifications() uint64
func (*ClientSideConnection).Err() error
func (*ClientSideConnection).SetLogger(l *slog.Logger)
func (*ClientSideConnection).Wait() error
func (*Closed).UnmarshalJSON(b []byte) error
func (Open).MarshalJSON() ([]byte, error)
func (*Open).UnmarshalJSON(b []byte) error
func (*Plain).UnmarshalJSON(b []byte) error
-- behaviour_test.go --
package acp

import (
	"bytes"
	"encoding/json"
	"reflect"
	"testing"
)

func jsonEqual(t *testing.T, got []byte, want string) {
	t.Helper()
	decode := func(b []byte) any {
		d := json.NewDecoder(bytes.NewReader(b))
		d.UseNumber()
		var v any
		if err := d.Decode(&v); err != nil {
			t.Fatalf("%s: %v", b, err)
		}
		return v
	}
	if !reflect.DeepEqual(decode(got), decode([]byte(want))) {
		t.Errorf("got %s, want %s", got, want)
	}
}

// Undeclared keys are kept byte for byte and sent back; a declared key read
// under case folding is not one of them.
func TestOpenKeepsExtra(t *testing.T) {
	var o Open
	in := `{"Code":1,"vendor":{"a":[true]},"n":123456789012345678901234567890}`
	if err := json.Unmarshal([]byte(in), &o); err != nil {
		t.Fatal(err)
	}
	if o.Code != 1 || len(o.Extra) != 2 || string(o.Extra["n"]) != "123456789012345678901234567890" {
		t.Fatalf("decoded as %+v", o)
	}
	b, err := json.Marshal(o)
	if err != nil {
		t.Fatal(err)
	}
	jsonEqual(t, b, `{"code":1,"vendor":{"a":[true]},"n":123456789012345678901234567890}`)
	// A declared field wins over an Extra key of the same name.
	o = Open{Code: 2, Extra: map[string]json.RawMessage{"code": json.RawMessage(`9`), "x": json.RawMessage(`"y"`)}}
	if b, err = json.Marshal(o); err != nil {
		t.Fatal(err)
	}
	jsonEqual(t, b, `{"code":2,"x":"y"}`)
}

// Without additionalProperties true the type has no Extra and drops the keys.
func TestClosedAndPlainDropExtra(t *testing.T) {
	for _, v := range []any{new(Closed), new(Plain)} {
		if err := json.Unmarshal([]byte(`{"code":1,"vendor":"x"}`), v); err != nil {
			t.Fatal(err)
		}
		b, err := json.Marshal(v)
		if err != nil {
			t.Fatal(err)
		}
		jsonEqual(t, b, `{"code":1}`)
	}
}
