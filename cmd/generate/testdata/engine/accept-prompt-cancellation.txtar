The protocol table's prompt turn: session/prompt is cancelled by
session/cancel on the same sessionId, and a turn cancelled before its handler
returns is answered with its stopReason's cancelled value whatever the handler
returned; session/update reaches the client as SessionUpdate.
The meta declares $/cancel_request and the schema its smallest definition, which
the runtime needs.

-- meta.json --
{"version": 1, "agentMethods": {"session_prompt": "session/prompt", "session_cancel": "session/cancel"}, "clientMethods": {"session_update": "session/update"}, "protocolMethods": {"cancel_request": "$/cancel_request"}}
-- schema.json --
{"$defs": {
  "PromptRequest": {"type": "object", "properties": {"sessionId": {"type": "string"}}, "required": ["sessionId"], "x-side": "agent", "x-method": "session/prompt"},
  "StopReason": {"type": "string", "enum": ["end_turn", "cancelled"]},
  "PromptResponse": {"type": "object", "properties": {"stopReason": {"$ref": "#/$defs/StopReason"}}, "required": ["stopReason"], "x-side": "agent", "x-method": "session/prompt"},
  "CancelNotification": {"type": "object", "properties": {"sessionId": {"type": "string"}}, "required": ["sessionId"], "x-side": "agent", "x-method": "session/cancel"},
  "SessionNotification": {"type": "object", "properties": {"sessionId": {"type": "string"}}, "required": ["sessionId"], "x-side": "client", "x-method": "session/update"},
  "CancelRequestNotification": {"type": "object", "x-side": "protocol", "x-method": "$/cancel_request"}
}}
-- want.api --
type Agent interface{Cancel(ctx context.Context, params CancelNotification) error; Prompt(ctx context.Context, params PromptRequest) (PromptResponse, error)}
type AgentExperimental interface{}
const AgentMethodSessionCancel untyped string = "session/cancel"
const AgentMethodSessionPrompt untyped string = "session/prompt"
type AgentSideConnection struct{conn *Connection; agent Agent; mu sync.Mutex; sessionCancels map[string][]*promptTurn; lateCancels map[string]uint64}
type CancelNotification struct{SessionId string "json:\"sessionId\""}
type CancelRequestNotification struct{}
type Client interface{SessionUpdate(ctx context.Context, params SessionNotification) error}
type ClientExperimental interface{}
const ClientMethodSessionUpdate untyped string = "session/update"
type ClientSideConnection struct{conn *Connection; client Client}
func NewAgentSideConnection(agent Agent, peerInput io.Writer, peerOutput io.Reader, opts ...ConnectionOption) *AgentSideConnection
func NewClientSideConnection(client Client, peerInput io.Writer, peerOutput io.Reader, opts ...ConnectionOption) *ClientSideConnection
type PromptRequest struct{SessionId string "json:\"sessionId\""}
type PromptResponse struct{StopReason StopReason "json:\"stopReason\""}
const ProtocolMethodCancelRequest untyped string = "$/cancel_request"
const ProtocolVersionNumber untyped int = 1
type SessionNotification struct{SessionId string "json:\"sessionId\""}
type StopReason string
const StopReasonCancelled StopReason = "cancelled"
const StopReasonEndTurn StopReason = "end_turn"
