-- behaviour_test.go --
package acp_test

import (
	"encoding/json"
	"errors"
	"slices"
	"testing"

	acp "enginetest/accept-enum-closed"
	"enginetest/accept-enum-closed/unstable"
)

func isEnumError(err error) bool {
	ve, ok := errors.AsType[*acp.ValidationError](err)
	return ok && ve.Rule == acp.RuleEnum
}

// Validate refuses a value Level does not list: always in a required field,
// and when set in an optional one.
func TestValidateClosed(t *testing.T) {
	for _, tc := range []struct {
		h    acp.Holder
		want bool
	}{
		{acp.Holder{Req: acp.LevelLow}, false},
		{acp.Holder{Req: ""}, true},
		{acp.Holder{Req: "bogus"}, true},
		{acp.Holder{Req: acp.LevelHigh, Opt: "bogus"}, true},
		{acp.Holder{Req: acp.LevelHigh, List: []acp.Level{acp.LevelLow, "bogus"}}, true},
	} {
		err := tc.h.Validate()
		if got := err != nil; got != tc.want || (got && !isEnumError(err)) {
			t.Errorf("%+v: Validate = %v, want an error %v", tc.h, err, tc.want)
		}
	}
}

// A received unknown value is kept in a strict field and read as absent in a
// lenient one.
func TestDecodeClosed(t *testing.T) {
	var h acp.Holder
	if err := json.Unmarshal([]byte(`{"req":"bogus","soft":"bogus","softPtr":"bogus","list":["low","bogus","high"]}`), &h); err != nil {
		t.Fatal(err)
	}
	if h.Req != "bogus" || h.Soft != "" || h.SoftPtr != nil || !slices.Equal(h.List, []acp.Level{acp.LevelLow, acp.LevelHigh}) {
		t.Errorf("decoded %+v", h)
	}
	h = acp.Holder{}
	if err := json.Unmarshal([]byte(`{"req":"low","soft":"high","softPtr":"low"}`), &h); err != nil {
		t.Fatal(err)
	}
	if h.Soft != acp.LevelHigh || h.SoftPtr == nil || *h.SoftPtr != acp.LevelLow {
		t.Errorf("known values decoded %+v", h)
	}
}

// Package unstable checks acp's Level in its own type.
func TestUnstableChecksAcpLevel(t *testing.T) {
	n, err := unstable.DecodePickN(json.RawMessage(`{"kind":"n","level":"bogus"}`))
	if err != nil {
		t.Fatal(err)
	}
	if err := n.Validate(); !isEnumError(err) {
		t.Errorf("PickN with level bogus: Validate = %v, want RuleEnum", err)
	}
	n.Level = acp.LevelHigh
	if err := n.Validate(); err != nil {
		t.Errorf("PickN with level high: Validate = %v", err)
	}
}
