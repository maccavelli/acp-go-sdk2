A closed enumeration, Level, is checked where it is held: Validate refuses a
value it does not list in a required field, and in an optional one when set,
with RuleEnum. A received value is kept where the field is strict, and read as
absent where the schema lets it default: a value field as "", a pointer as nil,
an item of a skip-invalid-items array as dropped. Package unstable's new
variant holds acp's Level, and checks it by its constants, since acp's known is
unexported (0049-PLAN-surface-fixes.md, phase 3).
The meta declares $/cancel_request and the schema its smallest definition, which
the runtime needs.

-- meta.json --
{"version": 1, "agentMethods": {"old": "x/old"}, "clientMethods": {}, "protocolMethods": {"cancel_request": "$/cancel_request"}}
-- schema.json --
{
  "$defs": {
    "OldRequest": {"type": "object", "properties": {"p": {"$ref": "#/$defs/Pick"}, "h": {"$ref": "#/$defs/Holder"}}, "required": ["p", "h"], "x-side": "agent", "x-method": "x/old"},
    "OldResponse": {"type": "object", "x-side": "agent", "x-method": "x/old"},
    "CancelRequestNotification": {"type": "object", "x-side": "protocol", "x-method": "$/cancel_request"},
    "Level": {"type": "string", "enum": ["low", "high"]},
    "Holder": {"type": "object", "required": ["req"], "properties": {
      "req": {"$ref": "#/$defs/Level"},
      "opt": {"$ref": "#/$defs/Level"},
      "soft": {"allOf": [{"$ref": "#/$defs/Level"}], "x-deserialize-default-on-error": true},
      "softPtr": {"anyOf": [{"$ref": "#/$defs/Level"}, {"type": "null"}], "x-deserialize-default-on-error": true},
      "list": {"type": ["array", "null"], "items": {"$ref": "#/$defs/Level"}, "x-deserialize-default-on-error": true, "x-deserialize-skip-invalid-items": true}}},
    "Pick": {"discriminator": {"propertyName": "kind"}, "oneOf": [{"type": "object", "properties": {"kind": {"const": "a", "type": "string"}}, "required": ["kind"]}]}
  }
}
