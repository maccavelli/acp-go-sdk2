-- behaviour_test.go --
package acp

import (
	"context"
	"errors"
	"io"
	"testing"
	"time"
)

// closingAgent's turn runs until its context ends, and reports its cause.
type closingAgent struct{ started, ended chan error }

func (a closingAgent) Prompt(ctx context.Context, _ PromptRequest) (PromptResponse, error) {
	a.started <- nil
	<-ctx.Done()
	a.ended <- context.Cause(ctx)
	return PromptResponse{}, ctx.Err()
}

func (closingAgent) Cancel(context.Context, CancelNotification) error { return nil }

func (closingAgent) CloseSession(context.Context, CloseSessionRequest) (CloseSessionResponse, error) {
	return CloseSessionResponse{}, nil
}

// waitingClient's permission handler ignores its context until the test ends.
type waitingClient struct{ asked, end chan struct{} }

func (c waitingClient) RequestPermission(context.Context, RequestPermissionRequest) (RequestPermissionResponse, error) {
	c.asked <- struct{}{}
	<-c.end
	return RequestPermissionResponse{Outcome: NewRequestPermissionOutcomeSelected("allow")}, nil
}

func closePair(t *testing.T) (*AgentSideConnection, *ClientSideConnection, closingAgent, waitingClient) {
	t.Helper()
	ar, cw := io.Pipe()
	cr, aw := io.Pipe()
	end := make(chan struct{})
	t.Cleanup(func() { close(end); _ = cw.Close(); _ = aw.Close() })
	agent := closingAgent{started: make(chan error, 1), ended: make(chan error, 1)}
	client := waitingClient{asked: make(chan struct{}, 1), end: end}
	return NewAgentSideConnection(agent, aw, ar), NewClientSideConnection(client, cw, cr), agent, client
}

func await[T any](t *testing.T, ch <-chan T, what string) T {
	t.Helper()
	select {
	case v := <-ch:
		return v
	case <-time.After(10 * time.Second):
		t.Fatalf("%s did not happen", what)
		panic("unreachable")
	}
}

// session/close cancels the session's running turn, answered cancelled.
func TestCloseCancelsTurn(t *testing.T) {
	_, c, agent, _ := closePair(t)
	answer := make(chan PromptResponse, 1)
	go func() {
		resp, err := c.Prompt(context.Background(), PromptRequest{SessionId: "s"})
		if err != nil {
			t.Errorf("Prompt: %v", err)
		}
		answer <- resp
	}()
	await(t, agent.started, "the turn")
	if _, err := c.CloseSession(t.Context(), CloseSessionRequest{SessionId: "s"}); err != nil {
		t.Fatal(err)
	}
	if cause := await(t, agent.ended, "the turn's end"); !errors.Is(cause, ErrPromptCancelled) {
		t.Errorf("the turn ended with %v, want ErrPromptCancelled", cause)
	}
	if resp := await(t, answer, "the prompt's answer"); resp.StopReason != StopReasonCancelled {
		t.Errorf("the prompt was answered %q, want cancelled", resp.StopReason)
	}
}

// A close the agent accepts answers the session's pending permission request
// with the cancelled outcome, though its handler has not returned.
func TestCloseAnswersPermission(t *testing.T) {
	a, c, _, client := closePair(t)
	answer := make(chan RequestPermissionResponse, 1)
	go func() {
		resp, err := a.RequestPermission(context.Background(), RequestPermissionRequest{SessionId: "s"})
		if err != nil {
			t.Errorf("RequestPermission: %v", err)
		}
		answer <- resp
	}()
	await(t, client.asked, "the permission request")
	if _, err := c.CloseSession(t.Context(), CloseSessionRequest{SessionId: "s"}); err != nil {
		t.Fatal(err)
	}
	if resp := await(t, answer, "the permission answer"); resp.Outcome.Cancelled == nil {
		t.Errorf("answered %+v, want the cancelled outcome", resp.Outcome)
	}
}
