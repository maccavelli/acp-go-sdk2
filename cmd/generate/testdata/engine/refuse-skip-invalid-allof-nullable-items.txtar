  "Maybe": {"anyOf": [{"$ref": "#/$defs/Item"}, {"type": "null"}]},
  "L": {"type": "object", "properties": {"xs": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/Maybe"}]}, "x-deserialize-skip-invalid-items": true}}},
