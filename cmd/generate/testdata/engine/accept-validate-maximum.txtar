  "Range": {"type": "object", "properties": {"hi": {"type": "integer", "format": "int64", "maximum": 10}, "r": {"type": ["number", "null"], "maximum": 1.5}}, "required": ["hi"]},
  "CancelRequestNotification": {"type": "object", "x-side": "protocol", "x-method": "$/cancel_request"}
}}
