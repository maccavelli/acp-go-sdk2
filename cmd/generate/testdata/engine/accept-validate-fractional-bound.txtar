An integer minimum or maximum with a fraction rounds inward, so it admits
exactly the integers the schema allows, and a uint64 bound above the int64
range is written as a uint64 (0019-PLAN-generator-hardening.md, G12 and G21).

-- meta.json --
{"version": 1, "agentMethods": {}, "clientMethods": {}, "protocolMethods": {"cancel_request": "$/cancel_request"}}
-- schema.json --
{"$defs": {
  "T": {"type": "object", "properties": {"lo": {"type": "integer", "format": "int64", "minimum": 1.5}, "hi": {"type": "integer", "format": "int64", "maximum": -1.5}, "u": {"type": "integer", "format": "uint64", "maximum": 1e19}}, "required": ["lo", "hi", "u"]},
  "CancelRequestNotification": {"type": "object", "x-side": "protocol", "x-method": "$/cancel_request"}
}}
