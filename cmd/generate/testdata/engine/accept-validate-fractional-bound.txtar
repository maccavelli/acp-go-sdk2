-- behaviour_test.go --
package acp

import (
	"strings"
	"testing"
)

func TestFractionalBounds(t *testing.T) {
	for _, tc := range []struct {
		v    T
		want string
	}{
		{T{Lo: 2, Hi: -2}, ""},
		{T{Lo: 1, Hi: -2}, "less than minimum 2"},
		{T{Lo: 2, Hi: -1}, "greater than maximum -2"},
		{T{Lo: 2, Hi: -2, U: 10000000000000000000}, ""},
		{T{Lo: 2, Hi: -2, U: 10000000000000000001}, "greater than maximum 10000000000000000000"},
	} {
		err := tc.v.Validate()
		switch {
		case tc.want == "" && err != nil:
			t.Errorf("%+v: %v", tc.v, err)
		case tc.want != "" && (err == nil || !strings.Contains(err.Error(), tc.want)):
			t.Errorf("%+v: error %v, want one containing %q", tc.v, err, tc.want)
		}
	}
}
