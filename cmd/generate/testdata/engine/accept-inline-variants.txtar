Inline variants: a struct, a named array type, and empty ones for a bare
title and for null. A $ref variant sits beside an inline one in W, a union
without properties of its own: in V, it could not hold V's shared key
(0014-PLAN-union-constructors-take-every-required-key.md, step 3 deviation).
The meta declares $/cancel_request and the schema its smallest definition, which
the runtime needs.

-- meta.json --
{"version": 1, "agentMethods": {}, "clientMethods": {}, "protocolMethods": {"cancel_request": "$/cancel_request"}}
-- schema.json --
{"$defs": {
  "Ref": {"type": "object", "properties": {"a": {"type": "string"}}},
  "V": {"required": ["shared"], "properties": {"shared": {"type": "string"}}, "anyOf": [{"type": "object", "properties": {"kind": {"type": "string"}, "opt": {"type": "array", "items": {"type": "string"}}}, "required": ["kind"], "description": "Object."}, {"title": "list", "type": "array", "items": {"type": "string"}}, {"title": "bare"}, {"type": "null"}]},
  "W": {"anyOf": [{"type": "object", "properties": {"w": {"type": "string"}}, "required": ["w"]}, {"$ref": "#/$defs/Ref"}]},
  "CancelRequestNotification": {"type": "object", "x-side": "protocol", "x-method": "$/cancel_request"}
}}
-- want.api --
