func NewVList(value []string) V
func NewVVVariant1(shared string, kind string) V
func NewVVVariant4() V
func NewWRef() W
func NewWWVariant1(w string) W
const ProtocolMethodCancelRequest untyped string = "$/cancel_request"
const ProtocolVersionNumber untyped int = 1
type Ref struct{A string "json:\"a,omitempty\""}
type V struct{VVariant1 *VVariant1 "json:\"-\""; List *VList "json:\"-\""; Bare *VBare "json:\"-\""; VVariant4 *VVariant4 "json:\"-\""}
type VBare struct{}
type VList []string
type VVariant1 struct{Kind string "json:\"kind\""; Opt []string "json:\"opt,omitempty\""; Shared string "json:\"shared\""}
type VVariant4 struct{}
type W struct{WVariant1 *WVariant1 "json:\"-\""; Ref *Ref "json:\"-\""}
type WVariant1 struct{W string "json:\"w\""}
