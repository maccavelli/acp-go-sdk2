-- behaviour_test.go --
package acp

import (
	"encoding/json"
	"testing"
)

// Each constructor sets its variant, and a value constructor takes a plain
// Go value; an array variant holding nil encodes as [] and decodes back.
func TestValueVariants(t *testing.T) {
	if b, err := json.Marshal(NewValWords(nil)); err != nil || string(b) != `[]` {
		t.Fatalf("NewValWords(nil) encoded as %s, %v", b, err)
	}
	var back Val
	if err := json.Unmarshal([]byte(`[]`), &back); err != nil || back.Words == nil {
		t.Errorf("[] decoded as %+v, %v", back, err)
	}
	var n int64 = 5
	if b, err := json.Marshal(NewValCount(n)); err != nil || string(b) != `5` {
		t.Errorf("NewValCount(5) encoded as %s, %v", b, err)
	}
	s := "w"
	if v := NewValText(s); v.Text == nil || string(*v.Text) != "w" {
		t.Errorf("NewValText set %+v", v)
	}
	if v := NewValName("n"); v.Name == nil || string(*v.Name) != "n" {
		t.Errorf("NewValName set %+v", v)
	}
	if v := NewValColor(ColorRed); v.Color == nil || *v.Color != ColorRed {
		t.Errorf("NewValColor set %+v", v)
	}
	if b, err := json.Marshal(NewValValVariant1()); err != nil || string(b) != `null` {
		t.Errorf("the null constructor encoded as %s, %v", b, err)
	}
	if v := NewValMarker(); v.Marker == nil {
		t.Errorf("NewValMarker set %+v", v)
	}
}
