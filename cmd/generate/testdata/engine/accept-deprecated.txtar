deprecated marks the Go declarations built from its node with a notice, as
the paragraph "Deprecated: the ACP schema marks <place> deprecated.": a
definition's type; a property's field, and an inline object property's
nested type; a union variant's field, inline type and helper; a constant
variant's constant; a flattened member's field; and a request definition's
methods, its interface method and its side connection's, while its response
is marked only by its own mark. A property whose $ref names a deprecated
definition gets no notice of its own, and deprecated false marks nothing
(0024-PLAN-api-gate-and-deprecation.md).
The meta declares $/cancel_request and the schema its smallest definition,
which the runtime needs.

-- meta.json --
{"version": 1, "agentMethods": {"hello": "x/hello"}, "clientMethods": {}, "protocolMethods": {"cancel_request": "$/cancel_request"}}
-- schema.json --
{"$defs": {
  "Old": {"type": "object", "description": "An old shape.", "properties": {"x": {"type": "string"}}, "deprecated": true},
  "Holder": {"type": "object", "properties": {
    "a": {"type": "string", "description": "A string.", "deprecated": true},
    "inner": {"type": "object", "properties": {"y": {"type": "string"}}, "deprecated": true},
    "old": {"$ref": "#/$defs/Old"},
    "keep": {"type": "string", "deprecated": false}
  }, "required": ["a"]},
  "Kept": {"type": "object", "properties": {"z": {"type": "string"}}, "deprecated": false},
  "U": {"oneOf": [
    {"type": "object", "properties": {"kind": {"type": "string", "const": "a"}}, "required": ["kind"], "deprecated": true},
    {"type": "object", "properties": {"kind": {"type": "string", "const": "b"}}, "required": ["kind"]}
  ]},
  "V": {"oneOf": [
    {"title": "Text", "type": "string", "deprecated": true},
    {"title": "Count", "type": "integer", "format": "int64"}
  ]},
  "Level": {"oneOf": [{"type": "string", "const": "low", "deprecated": true}, {"type": "string", "const": "high"}]},
  "SessionScope": {"type": "object", "properties": {"sessionId": {"type": "string"}}, "required": ["sessionId"]},
  "RequestScope": {"type": "object", "properties": {"requestId": {"type": "integer", "format": "int64"}}, "required": ["requestId"]},
  "Mode": {"type": "object", "properties": {"schema": {"type": "string"}}, "required": ["schema"], "anyOf": [
    {"title": "Session", "allOf": [{"$ref": "#/$defs/SessionScope"}], "deprecated": true},
    {"title": "Request", "allOf": [{"$ref": "#/$defs/RequestScope"}]}
  ]},
  "InitRequest": {"type": "object", "properties": {"v": {"type": "integer", "format": "uint16"}}, "required": ["v"], "x-side": "agent", "x-method": "x/hello", "deprecated": true},
  "InitResponse": {"type": "object", "properties": {"ok": {"type": "boolean"}}, "required": ["ok"], "x-side": "agent", "x-method": "x/hello"},
  "CancelRequestNotification": {"type": "object", "x-side": "protocol", "x-method": "$/cancel_request"}
}}
-- want.api --
