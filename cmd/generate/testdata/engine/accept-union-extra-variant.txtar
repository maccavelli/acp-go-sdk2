A discriminated union one of whose variants refers to an object that keeps
its undeclared keys in Extra. The union folds its keys on its map, so that
variant decodes from the payload, not from the union's map, and Extra keeps
each key as received (0019-PLAN-idioms-performance.md, D2). The meta declares
$/cancel_request and the schema its smallest definition, which the runtime
needs.

-- meta.json --
{"version": 1, "agentMethods": {}, "clientMethods": {}, "protocolMethods": {"cancel_request": "$/cancel_request"}}
-- schema.json --
{"$defs": {
  "Open": {"type": "object", "additionalProperties": true, "properties": {"kind": {"type": "string", "const": "a"}}, "required": ["kind"]},
  "U": {"oneOf": [
    {"$ref": "#/$defs/Open"},
    {"title": "Closed", "type": "object", "properties": {"kind": {"type": "string", "const": "b"}, "other": {"type": "string"}}, "required": ["kind", "other"]}
  ], "discriminator": {"propertyName": "kind"}},
  "CancelRequestNotification": {"type": "object", "x-side": "protocol", "x-method": "$/cancel_request"}
}}
-- want.api --
type Agent interface{}
type AgentExperimental interface{}
type AgentSideConnection struct{conn *Connection; agent Agent}
type CancelRequestNotification struct{}
type Client interface{}
type ClientExperimental interface{}
type ClientSideConnection struct{conn *Connection; client Client}
func NewAgentSideConnection(agent Agent, peerInput io.Writer, peerOutput io.Reader, opts ...ConnectionOption) *AgentSideConnection
func NewClientSideConnection(client Client, peerInput io.Writer, peerOutput io.Reader, opts ...ConnectionOption) *ClientSideConnection
func NewUA() U
func NewUB(other string) U
type Open struct{Kind string "json:\"kind\""; Extra map[string]json.RawMessage "json:\"-\""}
const ProtocolMethodCancelRequest untyped string = "$/cancel_request"
const ProtocolVersionNumber untyped int = 1
type U struct{A *Open "json:\"-\""; B *UClosed "json:\"-\""; Unknown json.RawMessage "json:\"-\""}
type UClosed struct{Kind string "json:\"kind\""; Other string "json:\"other\""}
func (*AgentSideConnection).Close() error
func (*AgentSideConnection).Connection() *Connection
func (*AgentSideConnection).Done() <-chan struct{}
func (*AgentSideConnection).DroppedNotifications() uint64
func (*AgentSideConnection).Err() error
func (*AgentSideConnection).SetLogger(l *slog.Logger)
func (*AgentSideConnection).Wait() error
func (*CancelRequestNotification).Validate() error
func (*ClientSideConnection).Close() error
func (*ClientSideConnection).Connection() *Connection
func (*ClientSideConnection).Done() <-chan struct{}
func (*ClientSideConnection).DroppedNotifications() uint64
func (*ClientSideConnection).Err() error
func (*ClientSideConnection).SetLogger(l *slog.Logger)
func (*ClientSideConnection).Wait() error
func (Open).MarshalJSON() ([]byte, error)
func (*Open).UnmarshalJSON(b []byte) error
func (U).MarshalJSON() ([]byte, error)
func (*U).UnmarshalJSON(b []byte) error
func (*U).Validate() error
func (*UClosed).UnmarshalJSON(b []byte) error
-- behaviour_test.go --
package acp

import (
	"encoding/json"
	"testing"
)

// A key the union folds, in another case, stays in Extra as received.
func TestUnionExtraVariant(t *testing.T) {
	var u U
	if err := json.Unmarshal([]byte(`{"kind":"a","OTHER":"x"}`), &u); err != nil {
		t.Fatal(err)
	}
	if u.A == nil || string(u.A.Extra["OTHER"]) != `"x"` || len(u.A.Extra) != 1 {
		t.Errorf("decoded as %+v, want Extra holding OTHER as received", u.A)
	}
}
