A key-less variant whose only required key is the discriminator: when no
known value matches, the union decodes it directly, with no key check.
The meta declares $/cancel_request and the schema its smallest definition, which
the runtime needs.

-- meta.json --
{"version": 1, "agentMethods": {}, "clientMethods": {}, "protocolMethods": {"cancel_request": "$/cancel_request"}}
-- schema.json --
{"$defs": {
  "U": {"anyOf": [{"type": "object", "properties": {"type": {"type": "string", "const": "a"}}, "required": ["type"]}, {"title": "loose", "type": "object", "required": ["type"], "properties": {"type": {"type": "string"}, "x": {"type": "string"}}}]},
  "CancelRequestNotification": {"type": "object", "x-side": "protocol", "x-method": "$/cancel_request"}
}}
-- want.api --
type Agent interface{}
type AgentExperimental interface{}
type CancelRequestNotification struct{}
type Client interface{}
type ClientExperimental interface{}
const ProtocolMethodCancelRequest untyped string = "$/cancel_request"
const ProtocolVersionNumber untyped int = 1
type U struct{A *UA "json:\"-\""; Loose *ULoose "json:\"-\""; Unknown json.RawMessage "json:\"-\""}
type UA struct{Type string "json:\"type\""}
type ULoose struct{Type string "json:\"type\""; X string "json:\"x,omitempty\""}
func (*CancelRequestNotification).Validate() error
func (U).MarshalJSON() ([]byte, error)
func (*U).UnmarshalJSON(b []byte) error
func (*U).Validate() error
-- behaviour_test.go --
package acp

import (
	"encoding/json"
	"testing"
)

// Without a type, a key-less variant that needs no key of its own takes the
// payload directly.
func TestKeyLessWithoutKeys(t *testing.T) {
	var u U
	if err := json.Unmarshal([]byte(`{"x":"v"}`), &u); err != nil {
		t.Fatal(err)
	}
	if u.Loose == nil || u.Loose.X != "v" {
		t.Errorf(`{"x":"v"} decoded as %+v, want Loose`, u)
	}
	u = U{}
	if err := json.Unmarshal([]byte(`{"type":"a"}`), &u); err != nil || u.A == nil {
		t.Errorf(`{"type":"a"}: %+v, %v`, u, err)
	}
}
