  "UnstableMcpError": {"type": "object", "properties": {"code": {"type": "integer", "format": "int32"}, "data": {"type": ["string", "null"], "description": "Optional error data; explicit null is retained."}}, "required": ["code"]},
  "CancelRequestNotification": {"type": "object", "x-side": "protocol", "x-method": "$/cancel_request"}
}}
