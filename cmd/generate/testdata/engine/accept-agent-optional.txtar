session/load, which the protocol table puts on AgentLoader. The table names the
capability loadSession, so the schema declares it on AgentCapabilities.
The meta declares $/cancel_request and the schema its smallest definition, which
the runtime needs.

-- meta.json --
{"version": 1, "agentMethods": {"session_load": "session/load"}, "clientMethods": {}, "protocolMethods": {"cancel_request": "$/cancel_request"}}
-- schema.json --
{"$defs": {
  "LoadSessionRequest": {"type": "object", "properties": {"sessionId": {"type": "string"}}, "required": ["sessionId"], "x-side": "agent", "x-method": "session/load"},
  "LoadSessionResponse": {"type": "object", "x-side": "agent", "x-method": "session/load"},
  "AgentCapabilities": {"type": "object", "properties": {"loadSession": {"type": "boolean", "default": false}}},
  "CancelRequestNotification": {"type": "object", "x-side": "protocol", "x-method": "$/cancel_request"}
}}
-- want.api --
