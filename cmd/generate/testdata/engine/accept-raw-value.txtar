A property the schema gives no type is kept as raw JSON; additionalProperties
true is an untyped map. A null in an optional raw property is an absent one,
and a required one keeps null (0012-MADR-schema-fidelity-framework.md,
amendment of 2026-10-11); Loose has no other reason to have a decoder.
The meta declares $/cancel_request and the schema its smallest definition, which
the runtime needs.

-- meta.json --
{"version": 1, "agentMethods": {}, "clientMethods": {}, "protocolMethods": {"cancel_request": "$/cancel_request"}}
-- schema.json --
{"$defs": {
  "Holder": {"type": "object", "properties": {"input": {"description": "Anything."}, "extra": {"description": "Anything else."}, "meta": {"type": ["object", "null"], "additionalProperties": true}}, "required": ["input"]},
  "Loose": {"type": "object", "properties": {"any": {}}},
  "CancelRequestNotification": {"type": "object", "x-side": "protocol", "x-method": "$/cancel_request"}
}}
-- want.api --
type Agent interface{}
type AgentExperimental interface{}
type AgentSideConnection struct{conn *Connection; agent Agent}
type CancelRequestNotification struct{}
type Client interface{}
type ClientExperimental interface{}
type ClientSideConnection struct{conn *Connection; client Client}
type Holder struct{Extra json.RawMessage "json:\"extra,omitempty\""; Input json.RawMessage "json:\"input\""; Meta map[string]any "json:\"meta,omitempty\""}
type Loose struct{Any json.RawMessage "json:\"any,omitempty\""}
func NewAgentSideConnection(agent Agent, peerInput io.Writer, peerOutput io.Reader, opts ...ConnectionOption) *AgentSideConnection
func NewClientSideConnection(client Client, peerInput io.Writer, peerOutput io.Reader, opts ...ConnectionOption) *ClientSideConnection
const ProtocolMethodCancelRequest untyped string = "$/cancel_request"
const ProtocolVersionNumber untyped int = 1
func (*AgentSideConnection).Connection() *Connection
func (*AgentSideConnection).Done() <-chan struct{}
func (*AgentSideConnection).DroppedNotifications() uint64
func (*AgentSideConnection).SetLogger(l *slog.Logger)
func (*CancelRequestNotification).Validate() error
func (*ClientSideConnection).Connection() *Connection
func (*ClientSideConnection).Done() <-chan struct{}
func (*ClientSideConnection).DroppedNotifications() uint64
func (*ClientSideConnection).SetLogger(l *slog.Logger)
func (*Holder).UnmarshalJSON(b []byte) error
func (*Loose).UnmarshalJSON(b []byte) error
-- behaviour_test.go --
package acp

import (
	"encoding/json"
	"strings"
	"testing"
)

// A value without a Go type is kept as received, every digit included, and
// sent back as it came.
func TestRawValue(t *testing.T) {
	in := `{"input":{"n":123456789012345678901234567890,"f":1.0000000000000000001}}`
	var h Holder
	if err := json.Unmarshal([]byte(in), &h); err != nil {
		t.Fatal(err)
	}
	if string(h.Input) != `{"n":123456789012345678901234567890,"f":1.0000000000000000001}` {
		t.Errorf("input kept as %s", h.Input)
	}
	b, err := json.Marshal(h)
	if err != nil {
		t.Fatal(err)
	}
	if !strings.Contains(string(b), "123456789012345678901234567890") || !strings.Contains(string(b), "1.0000000000000000001") {
		t.Errorf("encoded as %s", b)
	}
	if err := json.Unmarshal([]byte(`{"meta":{}}`), new(Holder)); err == nil {
		t.Error("a holder without its required input decoded")
	}
}

// A null in an optional raw property is an absent one: empty, and not sent. A
// required one keeps null, the value it carries.
func TestRawNullIsAbsent(t *testing.T) {
	var h Holder
	if err := json.Unmarshal([]byte(`{"input":null,"extra":null}`), &h); err != nil {
		t.Fatal(err)
	}
	if string(h.Input) != "null" || len(h.Extra) != 0 {
		t.Errorf("decoded input %q and extra %q, want null and empty", string(h.Input), string(h.Extra))
	}
	if b, err := json.Marshal(h); err != nil || string(b) != `{"input":null}` {
		t.Errorf("encoded as %s, %v", b, err)
	}
	var l Loose
	if err := json.Unmarshal([]byte(`{"any":null}`), &l); err != nil || len(l.Any) != 0 {
		t.Errorf("Loose decoded as %q, %v; want empty", string(l.Any), err)
	}
	if b, err := json.Marshal(l); err != nil || string(b) != `{}` {
		t.Errorf("Loose encoded as %s, %v", b, err)
	}
	if err := json.Unmarshal([]byte(`{"any":[1,2]}`), &l); err != nil || string(l.Any) != `[1,2]` {
		t.Errorf("Loose kept %q, %v", string(l.Any), err)
	}
}
