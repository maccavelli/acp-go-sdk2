The live unstable files drop the frozen method x/new and the definitions it
reached. The manifest keeps them: the API is accept-unstable-merge's, unchanged, and
x/new still reaches an agent that implements it
(0039-PLAN-five-adopter-additions-on-schema-1-25-0.md, 2c).

-- meta.json --
{"version": 1, "agentMethods": {"old": "x/old"}, "clientMethods": {}, "protocolMethods": {"cancel_request": "$/cancel_request"}}
-- schema.json --
{"$defs": {
  "Shared": {"type": "object", "properties": {"a": {"type": "string"}}},
  "OldRequest": {"type": "object", "properties": {"s": {"$ref": "#/$defs/Shared"}}, "required": ["s"], "x-side": "agent", "x-method": "x/old"},
  "OldResponse": {"type": "object", "x-side": "agent", "x-method": "x/old"},
  "CancelRequestNotification": {"type": "object", "x-side": "protocol", "x-method": "$/cancel_request"}
}}
-- meta.unstable.json --
{
  "version": 1,
  "agentMethods": {
    "old": "x/old"
  },
  "clientMethods": {
    "watch": "x/watch"
  },
  "protocolMethods": {
    "cancel_request": "$/cancel_request"
  }
}
