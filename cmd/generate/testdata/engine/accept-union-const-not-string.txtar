func NewClientSideConnection(client Client, peerInput io.Writer, peerOutput io.Reader, opts ...ConnectionOption) *ClientSideConnection
func NewUA(x string) U
func NewUB(y string) U
func NewUC(tag string, z string) U
const ProtocolMethodCancelRequest untyped string = "$/cancel_request"
const ProtocolVersionNumber untyped int = 1
type U struct{A *UNullable "json:\"-\""; B *UUntyped "json:\"-\""; C *UPlain "json:\"-\""; Unknown json.RawMessage "json:\"-\""}
type UNullable struct{Kind string "json:\"kind\""; Tag *string "json:\"tag,omitempty\""; X string "json:\"x\""}
type UPlain struct{Kind string "json:\"kind\""; Tag string "json:\"tag\""; Z string "json:\"z\""}
type UUntyped struct{Kind string "json:\"kind\""; Tag json.RawMessage "json:\"tag,omitempty\""; Y string "json:\"y\""}
