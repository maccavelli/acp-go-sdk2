A union whose variants carry, beside the discriminator, a constant in a field
that is not a string: a nullable constant is a *string, an untyped one a
json.RawMessage. Those arms encode the variant, then set the constants on the
encoded object; the arm whose constants are strings sets them on a copy and
encodes once (0019-PLAN-idioms-performance.md, D1). The discriminator is a
string in every variant, as the union's constructors write it. The meta
declares $/cancel_request and the schema its smallest definition, which the
runtime needs.

-- meta.json --
{"version": 1, "agentMethods": {}, "clientMethods": {}, "protocolMethods": {"cancel_request": "$/cancel_request"}}
-- schema.json --
{"$defs": {
  "U": {"oneOf": [
    {"title": "Nullable", "type": "object", "properties": {"kind": {"type": "string", "const": "a"}, "tag": {"type": ["string", "null"], "const": "t"}, "x": {"type": "string"}}, "required": ["kind", "x"]},
    {"title": "Untyped", "type": "object", "properties": {"kind": {"type": "string", "const": "b"}, "tag": {"const": "u"}, "y": {"type": "string"}}, "required": ["kind", "y"]},
    {"title": "Plain", "type": "object", "properties": {"kind": {"type": "string", "const": "c"}, "tag": {"type": "string", "const": "v"}, "z": {"type": "string"}}, "required": ["kind", "tag", "z"]}
  ], "discriminator": {"propertyName": "kind"}},
  "CancelRequestNotification": {"type": "object", "x-side": "protocol", "x-method": "$/cancel_request"}
}}
-- want.api --
