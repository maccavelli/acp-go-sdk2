-- behaviour_test.go --
package acp

import (
	"encoding/json"
	"testing"
)

// Each variant encodes with its constants, whatever its fields hold, and
// decodes back to the same variant.
func TestUnionConstNotString(t *testing.T) {
	for _, tt := range []struct {
		u    U
		want string
	}{
		{U{A: &UNullable{X: "1"}}, `{"kind":"a","tag":"t","x":"1"}`},
		{U{B: &UUntyped{Y: "2"}}, `{"kind":"b","tag":"u","y":"2"}`},
		{U{C: &UPlain{Z: "3"}}, `{"kind":"c","tag":"v","z":"3"}`},
	} {
		b, err := json.Marshal(tt.u)
		if err != nil || string(b) != tt.want {
			t.Errorf("%+v encoded as %s, %v; want %s", tt.u, b, err, tt.want)
			continue
		}
		var back U
		if err := json.Unmarshal(b, &back); err != nil {
			t.Errorf("%s does not decode: %v", b, err)
		}
		if (back.A != nil) != (tt.u.A != nil) || (back.B != nil) != (tt.u.B != nil) || (back.C != nil) != (tt.u.C != nil) {
			t.Errorf("%s decoded as %+v", b, back)
		}
	}
}
